{%- assign la = section.id -%}
{%- assign lm_tests = section.blocks | where: "type", "testimonial" -%}
{%- assign lm_steps = section.blocks | where: "type", "step" -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Mulish:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
#lmadv-{{ la }},#lmadv-{{ la }} *,#lmadv-{{ la }} *::before,#lmadv-{{ la }} *::after{box-sizing:border-box;margin:0;padding:0;}
#lmadv-{{ la }}{
  --bg:#fdfbf9;--bg-warm:#f7f3ee;--bg-dark:#1a1714;
  --ink:#181614;--ink-soft:#3a3530;--muted:#8a8078;
  --gold:#b8965a;--gold-lt:#d9bf8c;--gold-faint:#f0e6d0;
  --beige:#e8dfd3;--beige-mid:#d4c8b8;--white:#ffffff;
  --serif:'Playfair Display',Georgia,serif;
  --sans:'Mulish',system-ui,sans-serif;
  --shadow-sm:0 2px 12px rgba(0,0,0,0.06);
  --shadow-md:0 8px 32px rgba(0,0,0,0.10);
  --shadow-lg:0 20px 60px rgba(0,0,0,0.14);
  --r:3px;
  font-family:var(--sans);background:var(--bg);color:var(--ink);
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
#lmadv-{{ la }} img{display:block;width:100%;}

/* ANN */
#lmadv-{{ la }} .adv-ann{background:var(--ink);color:var(--gold-lt);text-align:center;padding:0.55rem 1rem;font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;font-weight:500;}

/* MASTHEAD */
#lmadv-{{ la }} .adv-masthead{display:flex;align-items:center;justify-content:center;padding:1.1rem 1.25rem;border-bottom:1px solid var(--beige);background:var(--bg);gap:0.75rem;}
#lmadv-{{ la }} .adv-mtag{font-size:0.58rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--muted);font-weight:500;}
#lmadv-{{ la }} .adv-msep{color:var(--beige-mid);font-size:0.8rem;}
#lmadv-{{ la }} .adv-mlogo img{height:{{ section.settings.logo_height }}px;width:auto;object-fit:contain;display:block;}

/* CONTAINER */
#lmadv-{{ la }} .adv-container{max-width:680px;margin:0 auto;padding:0 1.25rem;}

/* HERO */
#lmadv-{{ la }} .adv-hero{padding:3.5rem 0 0;text-align:center;position:relative;overflow:hidden;}
#lmadv-{{ la }} .adv-hero::before{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(184,150,90,0.08) 0%,transparent 70%);pointer-events:none;}
#lmadv-{{ la }} .adv-eyebrow{font-size:0.62rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:1.25rem;display:flex;align-items:center;justify-content:center;gap:0.6rem;}
#lmadv-{{ la }} .adv-eyebrow::before,#lmadv-{{ la }} .adv-eyebrow::after{content:'';width:28px;height:1px;background:var(--gold);opacity:0.4;}
#lmadv-{{ la }} .adv-hero h1{font-family:var(--serif);font-size:clamp(1.85rem,5.5vw,2.6rem);font-weight:700;line-height:1.18;color:var(--ink);max-width:580px;margin:0 auto 1.5rem;padding:0 0.5rem;}
#lmadv-{{ la }} .adv-hero h1 em{font-style:italic;color:var(--gold);}
#lmadv-{{ la }} .adv-hero-sub{font-size:0.95rem;line-height:1.75;color:var(--ink-soft);max-width:480px;margin:0 auto 2rem;font-weight:300;padding:0 0.5rem;}
#lmadv-{{ la }} .adv-hero-sub strong{font-weight:600;color:var(--ink);}

/* BUTTONS */
#lmadv-{{ la }} .adv-btn{display:inline-block;background:var(--ink);color:var(--gold-lt);padding:1rem 2.5rem;font-size:0.72rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;text-decoration:none;border:none;cursor:pointer;transition:background 0.25s,transform 0.18s;font-family:var(--sans);border-radius:var(--r);}
#lmadv-{{ la }} .adv-btn:hover{background:var(--ink-soft);transform:translateY(-1px);}
#lmadv-{{ la }} .adv-btn.gold{background:var(--gold);color:var(--ink);}
#lmadv-{{ la }} .adv-btn.gold:hover{background:var(--gold-lt);}
#lmadv-{{ la }} .adv-btn.full{width:100%;text-align:center;display:block;padding:1.1rem;font-size:0.8rem;}

/* HERO TRUST */
#lmadv-{{ la }} .adv-trust{display:flex;align-items:center;justify-content:center;gap:1.25rem;padding:1.25rem 1.25rem 0;flex-wrap:wrap;}
#lmadv-{{ la }} .trust-item{display:flex;align-items:center;gap:0.4rem;font-size:0.68rem;color:var(--muted);}
#lmadv-{{ la }} .trust-item svg{color:var(--gold);flex-shrink:0;}

/* HERO IMG */
#lmadv-{{ la }} .adv-hero-img{margin:2.5rem auto 0;position:relative;max-width:480px;}
#lmadv-{{ la }} .adv-hero-img img{width:100%;height:380px;object-fit:cover;display:block;}
#lmadv-{{ la }} .adv-img-ph{width:100%;height:380px;background:linear-gradient(160deg,var(--bg-warm),var(--beige));display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.75rem;}
#lmadv-{{ la }} .adv-img-ph p{font-size:0.58rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--muted);text-align:center;line-height:2;}
#lmadv-{{ la }} .adv-hero-badge{position:absolute;bottom:1.25rem;right:1.25rem;background:var(--white);border:1px solid var(--beige);padding:0.65rem 0.9rem;box-shadow:var(--shadow-md);text-align:center;}
#lmadv-{{ la }} .hib-num{font-family:var(--serif);font-size:1.5rem;font-weight:700;color:var(--ink);line-height:1;}
#lmadv-{{ la }} .hib-txt{font-size:0.55rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);margin-top:0.15rem;}

/* DIVIDER */
#lmadv-{{ la }} .adv-divider{display:flex;align-items:center;gap:0.75rem;padding:2.5rem 1.25rem;max-width:680px;margin:0 auto;}
#lmadv-{{ la }} .adv-divider-line{flex:1;height:1px;background:var(--beige);}
#lmadv-{{ la }} .adv-divider-gem{width:8px;height:8px;border:1px solid var(--gold);transform:rotate(45deg);flex-shrink:0;}

/* REASON */
#lmadv-{{ la }} .adv-reason{padding:0 0 3.5rem;}
#lmadv-{{ la }} .adv-reason-inner{max-width:680px;margin:0 auto;padding:0 1.25rem;}
#lmadv-{{ la }} .adv-reason-split{display:block;}
@media(min-width:600px){
  #lmadv-{{ la }} .adv-reason-split{display:grid;grid-template-columns:5fr 7fr;gap:2rem;align-items:start;}
  #lmadv-{{ la }} .adv-reason-photo{margin-bottom:0;}
  #lmadv-{{ la }} .adv-reason-photo img,#lmadv-{{ la }} .adv-reason-photo .rph{height:420px;}
}
#lmadv-{{ la }} .adv-reason-photo{position:relative;margin-bottom:1.5rem;overflow:hidden;}
#lmadv-{{ la }} .adv-reason-photo img{width:100%;height:360px;object-fit:cover;object-position:center top;display:block;}
#lmadv-{{ la }} .adv-reason-photo .rph{width:100%;height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.75rem;}
#lmadv-{{ la }} .adv-photo-cap{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(20,18,15,0.78) 0%,transparent 100%);padding:2.5rem 1.1rem 0.85rem;}
#lmadv-{{ la }} .cap-name{font-size:0.75rem;font-weight:700;color:var(--white);letter-spacing:0.06em;display:block;margin-bottom:0.15rem;}
#lmadv-{{ la }} .cap-meta{font-size:0.62rem;color:rgba(255,255,255,0.6);font-weight:300;letter-spacing:0.1em;}
#lmadv-{{ la }} .adv-reason-num{font-size:0.58rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:0.55rem;display:flex;align-items:center;gap:0.5rem;}
#lmadv-{{ la }} .adv-reason-num::after{content:'';height:1px;background:var(--gold-faint);width:28px;flex-shrink:0;}
#lmadv-{{ la }} .adv-reason h2{font-family:var(--serif);font-size:clamp(1.45rem,4.5vw,1.95rem);font-weight:700;line-height:1.2;color:var(--ink);margin-bottom:1rem;}
#lmadv-{{ la }} .adv-reason h2 em{font-style:italic;color:var(--gold);}
#lmadv-{{ la }} .adv-reason p{font-size:0.88rem;line-height:1.85;color:var(--ink-soft);font-weight:300;margin-bottom:0.9rem;}
#lmadv-{{ la }} .adv-reason p strong{font-weight:600;color:var(--ink);}
#lmadv-{{ la }} .adv-reason p:last-child{margin-bottom:0;}

/* REASON IMG (sin caption) */
#lmadv-{{ la }} .adv-reason-img{margin:1.5rem 0;overflow:hidden;}
#lmadv-{{ la }} .adv-reason-img img{width:100%;height:280px;object-fit:cover;object-position:top;}
#lmadv-{{ la }} .adv-reason-img .rph{width:100%;height:260px;background:linear-gradient(135deg,var(--bg-warm),var(--beige));display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;}

/* BEFORE/AFTER */
#lmadv-{{ la }} .adv-ba{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin:1.5rem 0;overflow:hidden;position:relative;}
#lmadv-{{ la }} .adv-ba-side{position:relative;}
#lmadv-{{ la }} .adv-ba-side .rph{height:230px;background:var(--bg-warm);display:flex;align-items:center;justify-content:center;}
#lmadv-{{ la }} .adv-ba-side img{height:230px;width:100%;object-fit:cover;object-position:top;}
#lmadv-{{ la }} .adv-ba-label{position:absolute;top:0.6rem;left:0.6rem;background:var(--white);color:var(--ink);font-size:0.52rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;padding:0.18rem 0.45rem;}
#lmadv-{{ la }} .adv-ba-sep{position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--white);transform:translateX(-50%);z-index:3;pointer-events:none;}

/* CHECK LIST */
#lmadv-{{ la }} .adv-checks{display:flex;flex-direction:column;gap:0.65rem;margin:1.25rem 0;}
#lmadv-{{ la }} .adv-check{display:flex;align-items:flex-start;gap:0.75rem;font-size:0.88rem;color:var(--ink-soft);font-weight:300;line-height:1.5;}
#lmadv-{{ la }} .adv-check-ico{width:18px;height:18px;background:var(--gold-faint);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;color:var(--gold);}

/* QUOTE CARD */
#lmadv-{{ la }} .adv-quote{background:var(--bg-warm);border-left:2px solid var(--gold);padding:1.25rem 1.5rem;margin:1.5rem 0;border-radius:0 var(--r) var(--r) 0;}
#lmadv-{{ la }} .adv-quote-text{font-family:var(--serif);font-size:1.05rem;font-style:italic;line-height:1.6;color:var(--ink);margin-bottom:0.5rem;}
#lmadv-{{ la }} .adv-quote-author{font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);font-weight:500;}

/* COMPARE TABLE */
#lmadv-{{ la }} .adv-compare{margin:1.75rem 0;border:1px solid var(--beige);border-radius:var(--r);overflow:hidden;}
#lmadv-{{ la }} .adv-compare-head{display:grid;grid-template-columns:1fr 1fr;background:var(--ink);}
#lmadv-{{ la }} .adv-ch-cell{padding:0.75rem 1rem;font-size:0.62rem;letter-spacing:0.15em;text-transform:uppercase;font-weight:600;color:var(--gold-lt);text-align:center;}
#lmadv-{{ la }} .adv-ch-cell:first-child{border-right:1px solid rgba(255,255,255,0.08);}
#lmadv-{{ la }} .adv-cr{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--beige);}
#lmadv-{{ la }} .adv-cr:last-child{border-bottom:none;}
#lmadv-{{ la }} .adv-cr.hl{background:var(--gold-faint);}
#lmadv-{{ la }} .adv-cr-cell{padding:0.85rem 1rem;font-size:0.85rem;text-align:center;color:var(--ink-soft);font-weight:300;}
#lmadv-{{ la }} .adv-cr-cell:first-child{border-right:1px solid var(--beige);color:var(--ink);font-weight:400;}
#lmadv-{{ la }} .adv-cr.hl .adv-cr-cell{font-weight:600;color:var(--ink);}
#lmadv-{{ la }} .adv-cr.hl .adv-cr-cell:last-child{color:var(--gold);}

/* OFFER */
#lmadv-{{ la }} .adv-offer-section{background:var(--bg-warm);padding:3.5rem 0;position:relative;overflow:hidden;}
#lmadv-{{ la }} .adv-offer-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(184,150,90,0.07) 0%,transparent 65%);pointer-events:none;}
#lmadv-{{ la }} .adv-offer-box{background:var(--white);border:1px solid var(--beige);border-top:3px solid var(--gold);padding:2.25rem 1.75rem;box-shadow:var(--shadow-lg);position:relative;border-radius:var(--r);}
#lmadv-{{ la }} .adv-offer-eyebrow{text-align:center;font-size:0.6rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:0.75rem;}
#lmadv-{{ la }} .adv-offer-title{font-family:var(--serif);font-size:clamp(1.5rem,5vw,2.1rem);font-weight:700;text-align:center;color:var(--ink);line-height:1.2;margin-bottom:0.5rem;}
#lmadv-{{ la }} .adv-offer-sub{text-align:center;font-size:0.82rem;color:var(--muted);font-weight:300;margin-bottom:1.75rem;}
#lmadv-{{ la }} .adv-timer{display:flex;align-items:center;justify-content:center;gap:0.4rem;margin-bottom:1.75rem;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);}
#lmadv-{{ la }} .adv-tblocks{display:flex;gap:0.3rem;align-items:center;}
#lmadv-{{ la }} .adv-tblock{background:var(--ink);color:var(--gold-lt);padding:0.35rem 0.55rem;font-size:1.1rem;font-weight:600;font-variant-numeric:tabular-nums;line-height:1;border-radius:2px;min-width:36px;text-align:center;font-family:var(--serif);}
#lmadv-{{ la }} .adv-tsep{color:var(--ink);font-size:1rem;font-weight:700;}
#lmadv-{{ la }} .adv-offer-includes{display:flex;flex-direction:column;gap:0.7rem;margin-bottom:1.75rem;padding:1.25rem;background:var(--bg-warm);border-radius:var(--r);}
#lmadv-{{ la }} .adv-oi-row{display:flex;align-items:center;gap:0.75rem;font-size:0.85rem;color:var(--ink-soft);}
#lmadv-{{ la }} .adv-oi-ico{color:var(--gold);flex-shrink:0;}
#lmadv-{{ la }} .adv-price-wrap{text-align:center;margin-bottom:1.5rem;}
#lmadv-{{ la }} .adv-price-old{font-size:0.7rem;color:var(--muted);text-decoration:line-through;margin-bottom:0.25rem;}
#lmadv-{{ la }} .adv-price{font-family:var(--serif);font-size:2.8rem;font-weight:700;color:var(--ink);line-height:1;}
#lmadv-{{ la }} .adv-price-note{font-size:0.68rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-top:0.25rem;}
#lmadv-{{ la }} .adv-stock{display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-top:1rem;font-size:0.7rem;color:#c0392b;font-weight:500;letter-spacing:0.06em;}
#lmadv-{{ la }} .adv-stock-dot{width:7px;height:7px;background:#c0392b;border-radius:50%;animation:lmadv-pulse-{{ la }} 1.5s infinite;}
@keyframes lmadv-pulse-{{ la }}{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.8);}}
#lmadv-{{ la }} .adv-offer-img{margin-bottom:1.5rem;border-radius:var(--r);overflow:hidden;}
#lmadv-{{ la }} .adv-offer-img img{width:100%;height:220px;object-fit:cover;}
#lmadv-{{ la }} .adv-offer-img .rph{height:220px;background:var(--bg-warm);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;}

/* TESTIMONIALS */
#lmadv-{{ la }} .adv-tests-section{padding:4rem 0;background:var(--bg);}
#lmadv-{{ la }} .adv-section-head{text-align:center;margin-bottom:2.5rem;padding:0 1.25rem;}
#lmadv-{{ la }} .adv-s-eyebrow{font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:0.75rem;}
#lmadv-{{ la }} .adv-s-title{font-family:var(--serif);font-size:clamp(1.4rem,4.5vw,1.9rem);font-weight:700;color:var(--ink);line-height:1.25;}
#lmadv-{{ la }} .adv-s-sub{font-size:0.82rem;color:var(--muted);font-weight:300;margin-top:0.5rem;}
#lmadv-{{ la }} .adv-rc-bar{display:flex;align-items:center;justify-content:center;gap:0.6rem;margin-bottom:2rem;font-size:0.72rem;color:var(--muted);}
#lmadv-{{ la }} .adv-rc-stars{color:var(--gold);font-size:0.85rem;}
#lmadv-{{ la }} .adv-tests-grid{display:flex;flex-direction:column;gap:1.25rem;padding:0 1.25rem;max-width:680px;margin:0 auto;}
@media(min-width:600px){
  #lmadv-{{ la }} .adv-tests-grid{display:grid;grid-template-columns:1fr 1fr;}
  #lmadv-{{ la }} .adv-tests-grid .adv-tcard:first-child{grid-column:1/-1;}
}
#lmadv-{{ la }} .adv-tcard{background:var(--white);border:1px solid var(--beige);padding:1.5rem;box-shadow:var(--shadow-sm);border-radius:var(--r);transition:box-shadow 0.25s;}
#lmadv-{{ la }} .adv-tcard:hover{box-shadow:var(--shadow-md);}
#lmadv-{{ la }} .adv-tc-top{display:flex;align-items:center;gap:0.85rem;margin-bottom:0.9rem;}
#lmadv-{{ la }} .adv-tc-avatar{width:42px;height:42px;border-radius:50%;background:var(--beige);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:1rem;font-weight:700;color:#7a6035;flex-shrink:0;}
#lmadv-{{ la }} .adv-tc-info{flex:1;}
#lmadv-{{ la }} .adv-tc-name{font-size:0.82rem;font-weight:600;color:var(--ink);}
#lmadv-{{ la }} .adv-tc-meta{font-size:0.65rem;color:var(--muted);margin-top:0.1rem;}
#lmadv-{{ la }} .adv-tc-stars{color:var(--gold);font-size:0.75rem;margin-left:auto;letter-spacing:0.05em;}
#lmadv-{{ la }} .adv-tc-text{font-family:var(--serif);font-size:1rem;font-style:italic;line-height:1.6;color:var(--ink);margin-bottom:0.75rem;}
#lmadv-{{ la }} .adv-tc-result{display:inline-flex;align-items:center;gap:0.35rem;background:var(--gold-faint);color:var(--gold);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:0.22rem 0.6rem;border-radius:1px;}
#lmadv-{{ la }} .adv-tc-verified{display:flex;align-items:center;gap:0.3rem;font-size:0.6rem;color:#3d7a50;margin-top:0.6rem;}

/* HOW TO USE */
#lmadv-{{ la }} .adv-howto{background:var(--bg-dark);padding:4rem 0;color:var(--white);}
#lmadv-{{ la }} .adv-howto .adv-s-title{color:var(--gold-lt);}
#lmadv-{{ la }} .adv-howto .adv-s-eyebrow{color:var(--gold);}
#lmadv-{{ la }} .adv-howto .adv-s-sub{color:rgba(255,255,255,0.4);}
#lmadv-{{ la }} .adv-steps{display:flex;flex-direction:column;gap:0;max-width:680px;margin:0 auto;padding:0 1.25rem;}
#lmadv-{{ la }} .adv-step{display:flex;gap:1.25rem;align-items:flex-start;padding:1.5rem 0;border-bottom:1px solid rgba(255,255,255,0.06);}
#lmadv-{{ la }} .adv-step:last-child{border-bottom:none;}
#lmadv-{{ la }} .adv-step-n{font-family:var(--serif);font-size:2.5rem;font-weight:700;color:var(--gold);line-height:1;opacity:0.4;min-width:2.5rem;flex-shrink:0;}
#lmadv-{{ la }} .adv-step-ico{width:44px;height:44px;background:rgba(184,150,90,0.12);border:1px solid rgba(184,150,90,0.25);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
#lmadv-{{ la }} .adv-step-body{flex:1;}
#lmadv-{{ la }} .adv-step-title{font-family:var(--serif);font-size:1.05rem;font-weight:500;color:var(--gold-lt);margin-bottom:0.35rem;}
#lmadv-{{ la }} .adv-step-desc{font-size:0.82rem;line-height:1.7;color:rgba(255,255,255,0.5);font-weight:300;}
#lmadv-{{ la }} .adv-howto-dur{text-align:center;margin-top:2rem;padding:1rem 1.25rem;}
#lmadv-{{ la }} .adv-dur-inner{display:inline-flex;align-items:center;gap:0.6rem;border:1px solid rgba(184,150,90,0.3);padding:0.65rem 1.25rem;font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold);font-weight:500;}

/* FINAL CTA */
#lmadv-{{ la }} .adv-final{background:var(--bg);padding:5rem 1.25rem;text-align:center;position:relative;overflow:hidden;}
#lmadv-{{ la }} .adv-final::before{content:'';position:absolute;bottom:-100px;left:50%;transform:translateX(-50%);width:600px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(184,150,90,0.07),transparent 70%);pointer-events:none;}
#lmadv-{{ la }} .adv-final .adv-s-title{font-size:clamp(1.6rem,5vw,2.4rem);margin-bottom:1rem;max-width:500px;margin-left:auto;margin-right:auto;}
#lmadv-{{ la }} .adv-final .adv-s-sub{max-width:400px;margin:0 auto 2.5rem;line-height:1.7;}
#lmadv-{{ la }} .adv-final-price{font-family:var(--serif);font-size:3rem;font-weight:700;color:var(--ink);line-height:1;margin-bottom:0.5rem;}
#lmadv-{{ la }} .adv-final-note{font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);margin-bottom:2rem;}
#lmadv-{{ la }} .adv-btn-final{display:block;width:100%;max-width:400px;margin:0 auto;background:var(--ink);color:var(--gold-lt);padding:1.15rem;font-size:0.78rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;border:none;cursor:pointer;font-family:var(--sans);border-radius:var(--r);transition:background 0.25s,transform 0.18s;text-decoration:none;}
#lmadv-{{ la }} .adv-btn-final:hover{background:var(--ink-soft);transform:translateY(-2px);}
#lmadv-{{ la }} .adv-final-trust{display:flex;align-items:center;justify-content:center;gap:1.5rem;margin-top:1.5rem;flex-wrap:wrap;}
#lmadv-{{ la }} .adv-ft-item{display:flex;align-items:center;gap:0.35rem;font-size:0.65rem;color:var(--muted);}
#lmadv-{{ la }} .adv-ft-item svg{color:var(--gold);}

/* FOOTER */
#lmadv-{{ la }} .adv-footer{background:var(--ink);padding:2.5rem 1.25rem 2rem;text-align:center;border-top:3px solid var(--gold);}
#lmadv-{{ la }} .adv-footer-logo img{height:{{ section.settings.footer_logo_height }}px;object-fit:contain;display:block;margin:0 auto 0.75rem;}
#lmadv-{{ la }} .adv-footer-tag{font-size:0.7rem;color:rgba(255,255,255,0.85);font-weight:300;line-height:1.7;margin-bottom:1.5rem;}
#lmadv-{{ la }} .adv-disclaimer{font-size:0.6rem;color:rgba(255,255,255,0.65);font-weight:300;line-height:1.7;max-width:500px;margin:0 auto 1rem;}
#lmadv-{{ la }} .adv-legal{display:flex;justify-content:center;gap:1.25rem;flex-wrap:wrap;}
#lmadv-{{ la }} .adv-legal a{font-size:0.6rem;color:rgba(255,255,255,0.7);text-decoration:none;}

/* REVEAL */
#lmadv-{{ la }} .reveal{opacity:0;transform:translateY(24px);transition:opacity 0.65s ease,transform 0.65s ease;}
#lmadv-{{ la }} .reveal.visible{opacity:1;transform:translateY(0);}
#lmadv-{{ la }} .reveal-d1{transition-delay:0.1s;}
#lmadv-{{ la }} .reveal-d2{transition-delay:0.2s;}
#lmadv-{{ la }} .reveal-d3{transition-delay:0.3s;}

/* STICKY CART */
#lmadv-sc-{{ la }}{position:fixed;bottom:0;left:0;right:0;z-index:200;background:#fff;border-top:1px solid #e8dfd3;padding:0.85rem 1.25rem;display:flex;align-items:center;gap:1rem;box-shadow:0 -8px 32px rgba(0,0,0,0.1);transform:translateY(100%);transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);}
#lmadv-sc-{{ la }}.show{transform:translateY(0);}
#lmadv-sc-{{ la }} .sc-info{flex:1;}
#lmadv-sc-{{ la }} .sc-name{font-size:0.8rem;font-weight:600;color:#181614;font-family:'Mulish',sans-serif;}
#lmadv-sc-{{ la }} .sc-price{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:700;color:#181614;line-height:1;}
#lmadv-sc-{{ la }} .sc-btn{background:#b8965a;color:#181614;border:none;padding:0.85rem 1.5rem;font-size:0.7rem;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;cursor:pointer;font-family:'Mulish',sans-serif;white-space:nowrap;border-radius:3px;transition:background 0.2s;text-decoration:none;display:inline-block;}
#lmadv-sc-{{ la }} .sc-btn:hover{background:#d9bf8c;}
</style>

