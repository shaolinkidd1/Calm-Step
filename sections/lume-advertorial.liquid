<!-- STICKY CART (fuera del div scoped) -->
<div id="lmadv-sc-{{ la }}">
  <div class="sc-info">
    <div class="sc-name">Lumé Facial Brush</div>
    <div class="sc-price">{{ section.settings.offer_price }}</div>
  </div>
  <a href="{{ section.settings.product_url }}" class="sc-btn">{{ section.settings.sticky_btn_text }}</a>
</div>

<script>
(function(){
  /* TIMER */
  var th=document.getElementById('lmadv-th-{{ la }}');
  var tm=document.getElementById('lmadv-tm-{{ la }}');
  var ts=document.getElementById('lmadv-ts-{{ la }}');
  if(th&&tm&&ts){
    var end=Date.now()+{{ section.settings.timer_minutes }}*60000;
    function p2(n){return String(n).padStart(2,'0');}
    function tick(){
      var d=Math.max(0,end-Date.now());
      th.textContent=p2(Math.floor(d/3600000));
      tm.textContent=p2(Math.floor((d%3600000)/60000));
      ts.textContent=p2(Math.floor((d%60000)/1000));
      if(d>0) setTimeout(tick,1000);
    }
    tick();
  }

  /* REVEAL */
  var W=document.getElementById('lmadv-{{ la }}');
  if(W&&'IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}
      });
    },{threshold:0.12});
    W.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else if(W) {
    W.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }

  /* STICKY CART */
  var sc=document.getElementById('lmadv-sc-{{ la }}');
  var hero=W?W.querySelector('.adv-hero'):null;
  if(sc&&hero){
    function chkSc(){sc.classList.toggle('show',hero.getBoundingClientRect().bottom<0);}
    window.addEventListener('scroll',chkSc,{passive:true});
    chkSc();
  }
})();
</script>

