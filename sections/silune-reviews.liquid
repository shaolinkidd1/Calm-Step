{%- assign sr = section.id -%}

<style>
#slrev-{{ sr }} {
  --lavender: #C8B8E8;
  --lavender-light: #E8DFF5;
  --lavender-bg: #EDE6F7;
  --black: #0A0A0A;
  --white: #FFFFFF;
  --gray-light: #F5F3F0;
  --gray-mid: #888;
  --gray-dark: #333;
  --border: #E0DCE8;
  --font-display: 'Bebas Neue', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  font-family: var(--font-body);
  color: var(--black);
}
#slrev-{{ sr }} .sl-reviews-section { border-top: 1px solid var(--border); max-width: 1200px; margin: 0 auto; padding: 50px 40px; }
#slrev-{{ sr }} .sl-stars { color: #F5A623; font-size: 16px; letter-spacing: 2px; }
#slrev-{{ sr }} .sl-rating-line { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
#slrev-{{ sr }} .sl-rating-line-label { font-size: 13px; width: 20px; }
#slrev-{{ sr }} .sl-rating-bar-wrap { flex: 1; height: 6px; background: var(--gray-light); border-radius: 3px; overflow: hidden; }
#slrev-{{ sr }} .sl-rating-bar { height: 100%; background: var(--black); border-radius: 3px; }
#slrev-{{ sr }} .sl-rating-line-count { font-size: 12px; color: var(--gray-mid); width: 30px; text-align: right; }
#slrev-{{ sr }} .sl-review-card { display: grid; grid-template-columns: 180px 1fr auto; gap: 30px; padding: 32px 0; border-bottom: 1px solid var(--border); align-items: start; }
#slrev-{{ sr }} .sl-reviewer-name { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
#slrev-{{ sr }} .sl-reviewer-badge { font-size: 11px; color: var(--gray-mid); margin-bottom: 10px; }
#slrev-{{ sr }} .sl-review-product-tag { font-size: 10px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gray-mid); margin-bottom: 6px; }
#slrev-{{ sr }} .sl-review-age { font-size: 12px; color: var(--gray-mid); }
#slrev-{{ sr }} .sl-review-stars { color: #F5A623; font-size: 13px; margin-bottom: 8px; }
#slrev-{{ sr }} .sl-review-date { font-size: 12px; color: var(--gray-mid); margin-bottom: 10px; }
#slrev-{{ sr }} .sl-review-title { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
#slrev-{{ sr }} .sl-review-body { font-size: 13px; line-height: 1.7; color: var(--gray-dark); }
#slrev-{{ sr }} .sl-read-more { font-size: 12px; font-weight: 600; color: var(--gray-mid); cursor: pointer; margin-top: 6px; display: block; }
#slrev-{{ sr }} .sl-review-helpful { font-size: 12px; color: var(--gray-mid); display: flex; gap: 8px; align-items: center; margin-top: 14px; }
#slrev-{{ sr }} .sl-helpful-btn { padding: 4px 10px; border: 1px solid var(--border); border-radius: 20px; cursor: pointer; background: var(--white); font-size: 11px; }
#slrev-{{ sr }} .sl-review-photos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
#slrev-{{ sr }} .sl-review-photo { width: 80px; height: 80px; object-fit: cover; border-radius: 4px; background: var(--gray-light); }
#slrev-{{ sr }} .sl-brand-response { display: flex; gap: 14px; margin-top: 16px; padding: 16px; background: var(--gray-light); border-radius: 4px; }
#slrev-{{ sr }} .sl-brand-avatar { width: 32px; height: 32px; background: var(--lavender); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
#slrev-{{ sr }} .sl-brand-response-text { font-size: 12px; line-height: 1.6; color: var(--gray-dark); }
#slrev-{{ sr }} .sl-brand-response-name { font-weight: 600; margin-bottom: 4px; font-size: 12px; }
#slrev-{{ sr }} .sl-featured-tag { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: var(--gray-mid); margin-top: 12px; }
#slrev-{{ sr }} .sl-featured-tag::before { content: '«'; font-size: 14px; }

@media (max-width: 768px) {
  #slrev-{{ sr }} .sl-reviews-section { padding: 36px 16px; }
  #slrev-{{ sr }} .sl-review-card { grid-template-columns: 1fr; gap: 10px; }
  #slrev-{{ sr }} .sl-review-photos-grid { grid-template-columns: 1fr 1fr; }
}
</style>

<div id="slrev-{{ sr }}">
  <div class="sl-reviews-section">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:30px;margin-bottom:20px">
      <div>
        <div style="display:flex;align-items:baseline;gap:8px">
          <span style="font-family:'Bebas Neue',sans-serif;font-size:64px;line-height:1">{{ section.settings.recommend_pct | default: '88%' }}</span>
        </div>
        <div style="font-size:13px;color:var(--gray-dark);margin-bottom:12px">recomendarían este producto</div>
        <div style="display:flex;align-items:center;gap:10px">
          <span class="sl-stars">★★★★½</span>
          <span style="font-size:13px;color:var(--gray-mid)">{{ section.settings.review_score | default: '4.5' }} · Basado en {{ section.settings.review_count | default: '1.223' }} reseñas*</span>
        </div>
      </div>
      <div style="min-width:220px">
        <div class="sl-rating-line"><span class="sl-rating-line-label">5</span><div class="sl-rating-bar-wrap"><div class="sl-rating-bar" style="width:80%"></div></div><span class="sl-rating-line-count">985</span></div>
        <div class="sl-rating-line"><span class="sl-rating-line-label">4</span><div class="sl-rating-bar-wrap"><div class="sl-rating-bar" style="width:7%"></div></div><span class="sl-rating-line-count">91</span></div>
        <div class="sl-rating-line"><span class="sl-rating-line-label">3</span><div class="sl-rating-bar-wrap"><div class="sl-rating-bar" style="width:3%"></div></div><span class="sl-rating-line-count">40</span></div>
        <div class="sl-rating-line"><span class="sl-rating-line-label">2</span><div class="sl-rating-bar-wrap"><div class="sl-rating-bar" style="width:3%"></div></div><span class="sl-rating-line-count">39</span></div>
        <div class="sl-rating-line"><span class="sl-rating-line-label">1</span><div class="sl-rating-bar-wrap"><div class="sl-rating-bar" style="width:5%"></div></div><span class="sl-rating-line-count">68</span></div>
      </div>
    </div>

    <div style="font-size:11px;color:var(--gray-mid);margin-bottom:30px;line-height:1.5">*¡Mismo producto, nuevo packaging! Desde su lanzamiento original, el packaging se ha actualizado, pero la fórmula reseñada es la misma.</div>
    <div style="display:flex;gap:16px;margin-bottom:30px;border-bottom:1px solid var(--border);padding-bottom:16px">
      <span style="font-size:14px;font-weight:600;border-bottom:2px solid var(--black);padding-bottom:2px">Reseñas ({{ section.settings.review_count | default: '1.223' }})</span>
    </div>

    <!-- Review 1 -->
    <div class="sl-review-card">
      <div>
        <div class="sl-reviewer-name">Charlene</div>
        <div class="sl-reviewer-badge">Compradora Verificada</div>
        <div class="sl-review-product-tag">{{ section.settings.product_name | default: 'SKINFLOW®' }} Suplemento<br>Acné Hormonal</div>
        <div class="sl-review-age">Rango de edad: 46–64</div>
      </div>
      <div>
        <div class="sl-review-stars">★★★★★</div>
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div class="sl-review-title">¡Realmente funciona!</div>
          <div class="sl-review-date">7 meses atrás</div>
        </div>
        <div class="sl-review-body">No soy principiante, soy una experta en acné. Lo he sufrido toda mi vida y después de la menopausia empeoró. Sé que es hormonal. Cuando probé este producto tenía la plena expectativa de que sería otro fracaso en una larga lista de fracasos. Pero maldición si no funciona. No sé qué brujería hay en esto...</div>
        <div class="sl-review-helpful">¿Te fue útil? <button class="sl-helpful-btn">👍 45</button> <button class="sl-helpful-btn">👎 0</button></div>
        <div class="sl-featured-tag">Destacada</div>
        <div class="sl-brand-response">
