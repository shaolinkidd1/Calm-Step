          </div>
        </div>
      </div>
      {%- if section.settings.rev_1_photo_1 != blank or section.settings.rev_1_photo_2 != blank -%}
      <div class="sl-review-photos-grid">
        {%- if section.settings.rev_1_photo_1 != blank -%}
