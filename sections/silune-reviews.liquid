        {%- if section.settings.rev_3_photo_1 != blank -%}<img class="sl-review-photo" src="{{ section.settings.rev_3_photo_1 | image_url: width: 200 }}" loading="eager" alt="">{%- else -%}<div class="sl-review-photo" style="background:#C8B8E8"></div>{%- endif -%}
        {%- if section.settings.rev_3_photo_2 != blank -%}<img class="sl-review-photo" src="{{ section.settings.rev_3_photo_2 | image_url: width: 200 }}" loading="eager" alt="">{%- else -%}<div class="sl-review-photo" style="background:#BBA8D5"></div>{%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <!-- Review 4 -->
    <div class="sl-review-card">
      <div>
        <div class="sl-reviewer-name">Ashley T.</div>
        <div class="sl-reviewer-badge">Compradora Verificada</div>
        <div class="sl-review-product-tag">{{ section.settings.product_name | default: 'SKINFLOW®' }} Suplemento<br>Acné Hormonal</div>
