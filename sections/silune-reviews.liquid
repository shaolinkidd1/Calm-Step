    <!-- Review 2 -->
    <div class="sl-review-card">
      <div>
        <div class="sl-reviewer-name">Lucía</div>
        <div class="sl-reviewer-badge">Compradora Verificada</div>
        <div class="sl-review-product-tag">{{ section.settings.product_name | default: 'SKINFLOW®' }} Suplemento<br>Acné Hormonal</div>
