<script>
(function() {

  // ANN BAR rotation
  var annSlides = document.querySelectorAll('.sl-ann-slide');
  var annIdx = 0;
  if (annSlides.length > 1) {
    setInterval(function() {
      annSlides[annIdx].classList.remove('active');
      annIdx = (annIdx + 1) % annSlides.length;
      annSlides[annIdx].classList.add('active');
    }, 3500);
  }

  // GALLERY
  var slImages = document.querySelectorAll('.sl-slide-img');
  var slDots = document.querySelectorAll('#sl-galleryDots span');
  var slIdx = 0;
  var slTotal = slImages.length;
  window.slChangeImg = function(dir) {
    if (slTotal < 2) return;
    if (slImages[slIdx]) slImages[slIdx].classList.remove('sl-active');
    if (slDots[slIdx]) slDots[slIdx].classList.remove('active');
    slIdx = (slIdx + dir + slTotal) % slTotal;
    if (slImages[slIdx]) slImages[slIdx].classList.add('sl-active');
    if (slDots[slIdx]) slDots[slIdx].classList.add('active');
  };
  slDots.forEach(function(dot, i) {
    dot.addEventListener('click', function() {
      if (i !== slIdx) {
        slImages[slIdx].classList.remove('sl-active');
        slDots[slIdx] && slDots[slIdx].classList.remove('active');
        slIdx = i;
        slImages[slIdx].classList.add('sl-active');
        slDots[slIdx] && slDots[slIdx].classList.add('active');
      }
    });
  });
  // TOUCH SWIPE (mobile only)
  var slGalleryEl = document.getElementById('sl-galleryMain');
  if (slGalleryEl) {
    var slTouchX = null;
    slGalleryEl.addEventListener('touchstart', function(e) {
      slTouchX = e.touches[0].clientX;
    }, { passive: true });
    slGalleryEl.addEventListener('touchend', function(e) {
      if (slTouchX === null) return;
      var dx = e.changedTouches[0].clientX - slTouchX;
      slTouchX = null;
      if (Math.abs(dx) < 30) return;
      slChangeImg(dx < 0 ? 1 : -1);
    }, { passive: true });
  }

  // MOBILE MENU
  var hamburger = document.querySelector('.sl-nav-hamburger');
  var mobileMenu = document.getElementById('sl-mobileMenu');
  var menuOverlay = document.getElementById('sl-menuOverlay');
  var menuClose = document.getElementById('sl-menuClose');
  function openMenu() { mobileMenu.classList.add('open'); menuOverlay.classList.add('open'); document.body.classList.add('sl-menu-open'); }
  function closeMenu() { mobileMenu.classList.remove('open'); menuOverlay.classList.remove('open'); document.body.classList.remove('sl-menu-open'); }
  if (hamburger) hamburger.addEventListener('click', openMenu);
  if (menuClose) menuClose.addEventListener('click', closeMenu);
  if (menuOverlay) menuOverlay.addEventListener('click', closeMenu);
  // Cerrar al hacer clic en link dentro del menú
  if (mobileMenu) mobileMenu.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', closeMenu); });

  // CART COUNT (Shopify Ajax API)
  function slUpdateCartCount() {
    fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(d) { var el = document.getElementById('sl-cartCount'); if (el) el.textContent = d.item_count; })
      .catch(function() {});
  }
  slUpdateCartCount();

  // QTY / PURCHASE
  var variantIds = {
    '1': '{{ _lp_vid1 | default: section.settings.variant_id_1 | default: "" }}',
    '2': '{{ _lp_vid2 | default: section.settings.variant_id_2 | default: "" }}',
    '3': '{{ _lp_vid3 | default: section.settings.variant_id_3 | default: "" }}'
  };
  var sellingPlanId = '{{ _lp_selling_plan_id | default: section.settings.selling_plan_id | default: "" }}'.trim();
  var currentQty = '1';
  var currentPrice = '{{ section.settings.price_1 | default: "$34.980" }}';
  var currentPriceSub = '{{ section.settings.price_1_sub | default: "$31.482" }}';
  var purchaseMode = 'once';

  function slSyncStickyPrice() {
    var el = document.getElementById('sl-sticky-price');
    if (el) el.textContent = purchaseMode === 'once' ? currentPrice : currentPriceSub;
  }

  window.slSelectQty = function(btn, qty, price, priceSub) {
    document.querySelectorAll('.sl-option-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    currentQty = qty; currentPrice = price; currentPriceSub = priceSub;
    document.getElementById('sl-priceOnce').textContent = price;
    document.getElementById('sl-priceSub').textContent = priceSub;
    document.getElementById('sl-ctaPrice').textContent = purchaseMode === 'once' ? price : priceSub;
    slSyncStickyPrice();
    var qtyEl = document.getElementById('sl-sticky-qty');
    if (qtyEl) qtyEl.textContent = btn.textContent;
  };

  window.slSelectPurchase = function(el, mode) {
    document.querySelectorAll('.sl-purchase-option').forEach(function(o) {
      o.classList.remove('selected');
      o.querySelector('.sl-radio').classList.remove('checked');
    });
    el.classList.add('selected');
    el.querySelector('.sl-radio').classList.add('checked');
    purchaseMode = mode;
    document.getElementById('sl-ctaPrice').textContent = mode === 'once' ? currentPrice : currentPriceSub;
    slSyncStickyPrice();
  };

  window.slAddToCart = function() {
    var vid = (variantIds[currentQty] || '').trim();
    var productUrl = '{{ _lp_url | default: section.settings.product_url | default: "" }}'.trim();
    var btn        = document.getElementById('sl-ctaBtn');
    var stickyBtn  = document.getElementById('sl-sticky-btn');
    var label      = btn ? btn.querySelector('span:first-child') : null;

    function setLoading(on) {
      if (btn)       { btn.disabled = on;       if (label) label.textContent = on ? 'Agregando…' : 'Agregar al Carro'; }
      if (stickyBtn) { stickyBtn.disabled = on; stickyBtn.textContent = on ? 'Agregando…' : 'Agregar al Carro'; }
    }
    function setSuccess() {
      if (label)     label.textContent = '✓ Agregado al carro';
      if (btn)       btn.style.background = '#207020';
      if (stickyBtn) { stickyBtn.textContent = '✓ Agregado'; stickyBtn.style.background = '#207020'; }
      slUpdateCartCount();
      setTimeout(function() {
        if (label)     label.textContent = 'Agregar al Carro';
        if (btn)       { btn.style.background = ''; btn.disabled = false; }
        if (stickyBtn) { stickyBtn.textContent = 'Agregar al Carro'; stickyBtn.style.background = ''; stickyBtn.disabled = false; }
      }, 2200);
    }

    if (vid !== '') {
      setLoading(true);
      var cartBody = { id: parseInt(vid, 10), quantity: 1 };
      if (purchaseMode === 'sub' && sellingPlanId !== '') {
        cartBody.selling_plan = parseInt(sellingPlanId, 10);
      }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(cartBody)
      })
      .then(function(r) { if (!r.ok) throw r; return r.json(); })
      .then(setSuccess)
      .catch(function() {
        setLoading(false);
        if (productUrl) window.location.href = productUrl;
      });
    } else if (productUrl) {
      window.location.href = productUrl;
    }
  };

  // STICKY ADD TO CART — show when main CTA is out of view AND footer is not visible
  (function() {
    var stickyBar = document.getElementById('sl-sticky-atc');
    var mainBtn   = document.getElementById('sl-ctaBtn');
    if (!stickyBar || !mainBtn) return;

    var ctaVisible    = true;
    var footerVisible = false;

    function update() {
      stickyBar.classList.toggle('visible', !ctaVisible && !footerVisible);
    }

    // Hide when main CTA button is visible
    new IntersectionObserver(function(entries) {
      ctaVisible = entries[0].isIntersecting;
      update();
    }, { threshold: 0 }).observe(mainBtn);

    // Hide when footer enters viewport — scroll-based for reliable cross-section detection
    function checkFooter() {
      var footer = document.querySelector('.sl-footer') ||
                   document.querySelector('footer') ||
                   document.querySelector('[class*="footer"]');
      if (footer) {
        footerVisible = footer.getBoundingClientRect().top < window.innerHeight;
      } else {
        var barH = stickyBar.offsetHeight || 70;
        footerVisible = (document.documentElement.scrollHeight - window.innerHeight - window.scrollY) < barH;
      }
      update();
    }

    window.addEventListener('scroll', checkFooter, { passive: true });
    checkFooter();
  })();

  // ACCORDION
  window.slToggleAcc = function(header) {
    var content = header.nextElementSibling;
    var isOpen = header.classList.contains('open');
    header.classList.toggle('open', !isOpen);
    content.classList.toggle('open', !isOpen);
  };



})();
</script>

