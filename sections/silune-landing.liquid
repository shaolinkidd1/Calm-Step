  {%- assign _lp_p2 = lp.variants[1].price | money -%}
  {%- assign _lp_p3 = lp.variants[2].price | money -%}
  {%- assign _lp_url = lp.url -%}
  {%- assign _lp_selling_plan_id = '' -%}
  {%- if lp.selling_plan_groups.size > 0 -%}
    {%- assign _lp_selling_plan_id = lp.selling_plan_groups.first.selling_plans.first.id -%}
  {%- endif -%}
{%- endif -%}
