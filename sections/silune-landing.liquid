<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">

<style>
.sl-wrap *, .sl-wrap *::before, .sl-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --lavender: #C8B8E8;
  --lavender-light: #E8DFF5;
  --lavender-bg: #EDE6F7;
  --black: #0A0A0A;
  --white: #FFFFFF;
  --gray-light: #F5F3F0;
  --gray-mid: #888;
  --gray-dark: #333;
  --border: #E0DCE8;
  --font-display: 'Bebas Neue', sans-serif;
  --font-body: 'DM Sans', sans-serif;
}

html { scroll-behavior: smooth; }
body { font-family: var(--font-body); background: var(--white); color: var(--black); font-size: 15px; }

/* ANN BAR */
.sl-ann-bar {
  background: var(--lavender);
  text-align: center;
  padding: 10px 20px;
  overflow: hidden;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sl-ann-track { position: relative; width: 100%; }
.sl-ann-slide {
  position: absolute; width: 100%; left: 0;
  font-size: 13px; font-weight: 500; letter-spacing: 0.02em;
  opacity: 0; transform: translateY(10px);
  transition: opacity 0.5s ease, transform 0.5s ease;
  pointer-events: none;
}
.sl-ann-slide.active { opacity: 1; transform: translateY(0); position: relative; pointer-events: auto; }

/* NAV */
.sl-nav {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 32px;
  height: 64px;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  background: var(--white);
  z-index: 100;
}
.sl-nav-left { display: flex; align-items: center; justify-content: flex-start; }
.sl-nav-hamburger {
  background: none; border: none; cursor: pointer;
  display: flex; flex-direction: column; gap: 5px; padding: 6px 4px;
}
.sl-nav-hamburger span { display: block; width: 22px; height: 1.5px; background: var(--black); transition: opacity 0.15s; }
.sl-nav-hamburger:hover span { opacity: 0.5; }
.sl-nav-logo {
  font-family: var(--font-display);
  font-size: 28px; letter-spacing: 0.08em;
  color: var(--black); text-decoration: none;
  text-align: center; white-space: nowrap;
  display: flex; align-items: center; justify-content: center;
}
.sl-nav-logo img { height: var(--header-logo-h, 32px); width: auto; display: block; }
.sl-nav-right { display: flex; gap: 18px; align-items: center; justify-content: flex-end; }
.sl-nav-right a { display: flex; align-items: center; color: var(--black); text-decoration: none; }
.sl-nav-right svg { width: 20px; height: 20px; }
.sl-cart-btn { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; text-decoration: none; color: var(--black); }
.sl-cart-count { background: var(--black); color: var(--white); width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; }

/* PRODUCT HERO */
.sl-product-hero {
  display: grid; grid-template-columns: 1fr 1fr;
  max-width: 1200px; margin: 0 auto;
  gap: 0;
}
.sl-gallery { position: relative; }
.sl-gallery-main {
  width: 100%;
  padding-top: 100%; /* ratio 1:1 */
  position: relative;
  overflow: hidden;
  background: var(--gray-light);
}
.sl-gallery-slides {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.sl-slide-img {
  position: absolute !important;
  top: 0 !important; left: 0 !important;
  width: 100% !important; height: 100% !important;
  object-fit: cover !important;
  display: none;
}
.sl-slide-img.sl-active { display: block !important; }
.sl-gallery-nav {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 36px; height: 36px; background: var(--white);
  border: 1px solid var(--border); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; z-index: 10; font-size: 18px;
}
.sl-gallery-nav.prev { left: 12px; }
.sl-gallery-nav.next { right: 12px; }
.sl-gallery-dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
.sl-gallery-dots span { width: 8px; height: 8px; border-radius: 50%; background: var(--border); cursor: pointer; }
.sl-gallery-dots span.active { background: var(--black); }

.sl-product-info { padding: 40px 40px 60px; }
.sl-product-stars-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.sl-stars-display { position: relative; display: inline-block; font-size: 16px; letter-spacing: 3px; line-height: 1; }
.sl-stars-bg { color: #D8D0E8; }
.sl-stars-fg { position: absolute; top: 0; left: 0; overflow: hidden; white-space: nowrap; color: #F5A623; pointer-events: none; }
.sl-stars-hero-label { font-size: 12px; color: var(--gray-mid); }
.sl-product-subtitle { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray-mid); margin-bottom: 6px; }
.sl-product-title { font-family: var(--font-display); font-size: 46px; line-height: 1; letter-spacing: 0.03em; margin-bottom: 14px; }
.sl-product-title sup { font-size: 22px; }
.sl-product-tagline { font-size: 13px; color: var(--gray-dark); line-height: 1.6; margin-bottom: 6px; }
.sl-product-tagline p { margin: 0; }
.sl-product-tagline a { color: var(--black); font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }

.sl-option-label { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray-mid); margin-bottom: 10px; }
.sl-option-btns { display: flex; gap: 10px; margin-bottom: 24px; }
.sl-option-btn { padding: 8px 20px; border: 1.5px solid var(--border); border-radius: 4px; font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; background: var(--white); color: var(--black); transition: all 0.15s; }
.sl-option-btn.active { border-color: var(--black); background: var(--black); color: var(--white); }

.sl-purchase-options { margin-bottom: 22px; }
.sl-purchase-option {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px; border: 1.5px solid var(--border);
  border-radius: 4px; margin-bottom: 8px; cursor: pointer; transition: border-color 0.15s;
}
.sl-purchase-option.selected { border-color: var(--black); }
.sl-purchase-option-left { display: flex; align-items: center; gap: 12px; }
.sl-radio { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.sl-radio.checked { border-color: var(--black); }
.sl-radio.checked::after { content: ''; width: 10px; height: 10px; background: var(--black); border-radius: 50%; }
.sl-purchase-option-text { font-size: 14px; font-weight: 500; }
.sl-purchase-option-price { font-size: 14px; font-weight: 500; }
.sl-purchase-option-sub { font-size: 11px; color: var(--gray-mid); }

.sl-cta-btn {
  width: 100%; background: var(--black); color: var(--white); border: none;
  padding: 18px; font-family: var(--font-body); font-size: 15px; font-weight: 600;
  letter-spacing: 0.04em; cursor: pointer; border-radius: 4px;
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12px; transition: background 0.15s;
}
.sl-cta-btn:hover { background: #222; }
.sl-shipping-note { font-size: 12px; color: var(--gray-mid); margin-bottom: 24px; }

.sl-accordion { border-top: 1px solid var(--border); }
.sl-accordion-item { border-bottom: 1px solid var(--border); }
.sl-accordion-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; cursor: pointer; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
.sl-accordion-header span { font-size: 20px; font-weight: 300; transition: transform 0.2s; }
.sl-accordion-header.open span { transform: rotate(45deg); }
.sl-accordion-content { display: none; padding-bottom: 16px; font-size: 13px; line-height: 1.7; color: var(--gray-dark); }
.sl-accordion-content.open { display: block; }

/* TICKER */
.sl-ticker { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 12px 0; overflow: hidden; white-space: nowrap; }
.sl-ticker-track { display: inline-flex; gap: 0; animation: sl-ticker 18s linear infinite; }
.sl-ticker-item { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 0 30px; }
.sl-ticker-dot { width: 4px; height: 4px; background: var(--black); border-radius: 50%; }
@keyframes sl-ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* CLINICAL */
.sl-clinical { display: grid; grid-template-columns: 1fr 1fr; min-height: 480px; }
.sl-clinical-img { position: relative; overflow: hidden; background: var(--gray-light); }
.sl-clinical-img img { width: 100%; height: 100%; object-fit: cover; }
.sl-clinical-data { background: var(--white); padding: 60px 60px; display: flex; flex-direction: column; justify-content: center; }
.sl-clinical-title { font-family: var(--font-display); font-size: 48px; letter-spacing: 0.04em; margin-bottom: 40px; }
.sl-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
.sl-stat-num { font-family: var(--font-display); font-size: 64px; line-height: 1; letter-spacing: 0.02em; margin-bottom: 8px; }
.sl-stat-desc { font-size: 13px; line-height: 1.5; color: var(--gray-dark); max-width: 180px; }
.sl-clinical-note { font-size: 10px; color: var(--gray-mid); margin-top: 24px; line-height: 1.5; }

/* GOOD FOR BAND */
.sl-good-for-band { background: var(--lavender); padding: 40px; display: flex; align-items: center; gap: 20px; }
.sl-good-for-label { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--black); opacity: 0.6; }
.sl-good-for-title { font-family: var(--font-display); font-size: 36px; letter-spacing: 0.04em; color: var(--black); }

/* PRODUCT DETAILS */
.sl-product-details { display: grid; grid-template-columns: 1fr 1fr; }
.sl-details-left { padding: 50px 50px; border-right: 1px solid var(--border); }
.sl-details-right { background: var(--gray-light); display: flex; align-items: center; justify-content: center; padding: 40px; overflow: hidden; }
.sl-details-right.has-img { padding: 0; }
.sl-details-right.has-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sl-detail-block { margin-bottom: 32px; }
.sl-detail-block-label { font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray-mid); margin-bottom: 8px; }
.sl-detail-block-value { font-family: var(--font-display); font-size: 42px; line-height: 1.1; letter-spacing: 0.02em; }
.sl-detail-block-value.small { font-size: 22px; line-height: 1.4; }

.sl-bottle { width: 70%; max-width: 280px; background: var(--white); border-radius: 12px; padding: 24px 20px; text-align: center; box-shadow: 0 4px 40px rgba(0,0,0,0.08); }
.sl-bottle-brand { font-family: var(--font-display); font-size: 14px; letter-spacing: 0.15em; margin-bottom: 4px; }
.sl-bottle-name { font-family: var(--font-display); font-size: 20px; letter-spacing: 0.08em; line-height: 1.1; margin-bottom: 6px; }
.sl-bottle-label { font-size: 9px; color: var(--gray-mid); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 12px; line-height: 1.5; }
.sl-bottle-icon { width: 80px; height: 110px; background: linear-gradient(145deg, #E8DFF5, #C8B8E8); border-radius: 40px 40px 20px 20px; margin: 0 auto 12px; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.sl-bottle-icon::before { content: ''; position: absolute; top: -10px; width: 30px; height: 14px; background: #B8A8D8; border-radius: 4px 4px 0 0; }
.sl-bottle-icon-text { font-family: var(--font-display); font-size: 11px; letter-spacing: 0.1em; color: rgba(0,0,0,0.5); text-align: center; padding: 0 10px; }
.sl-bottle-count { font-size: 11px; color: var(--gray-mid); margin-top: 8px; }

/* FAQ */
.sl-faq-section { border-top: 1px solid var(--border); display: grid; grid-template-columns: 1fr 1fr; max-width: 1200px; margin: 0 auto; padding: 60px 40px; gap: 60px; }
.sl-faq-title { font-family: var(--font-display); font-size: 48px; letter-spacing: 0.03em; line-height: 1.1; align-self: start; }

/* MARQUEE */


/* PERSON PLACEHOLDER */
.sl-person-placeholder { width: 100%; height: 100%; background: linear-gradient(160deg, #D4C5E8 0%, #C8B8E8 100%); display: flex; align-items: center; justify-content: center; min-height: 480px; }

/* SOCIAL ICONS */
  border: 1px solid rgba(0,0,0,0.18); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(0,0,0,0.5); text-decoration: none;
  font-size: 10px; font-weight: 700; transition: all 0.14s;
}

/* MOBILE MENU DRAWER */
.sl-menu-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.45); z-index: 200;
}
.sl-menu-overlay.open { display: block; }
.sl-mobile-menu {
  position: fixed; top: 0; left: 0;
  width: 300px; height: 100vh;
  background: var(--white); z-index: 300;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  overflow-y: auto; display: flex; flex-direction: column;
}
.sl-mobile-menu.open { transform: translateX(0); }
.sl-mobile-menu-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 24px; border-bottom: 1px solid var(--border);
}
.sl-mobile-menu-logo {
  font-family: var(--font-display); font-size: 24px;
  letter-spacing: 0.08em; color: var(--black); text-decoration: none;
  display: flex; align-items: center;
}
.sl-mobile-menu-logo img { height: var(--header-logo-h, 28px); width: auto; display: block; }
.sl-skinflow2-note { font-size: 12px; color: var(--gray-mid); margin-top: 6px; margin-bottom: 20px; line-height: 1.5; }
.sl-skinflow2-link { color: var(--black); font-weight: 700; text-decoration: underline; text-underline-offset: 2px; letter-spacing: 0.01em; }
.sl-mobile-menu-close {
  background: none; border: none; cursor: pointer;
  font-size: 28px; line-height: 1; color: var(--black); padding: 2px 6px;
}
.sl-mobile-menu-nav { padding: 8px 24px; }
.sl-mobile-menu-nav a {
  display: block; font-size: 16px; font-weight: 500;
  color: var(--black); text-decoration: none;
  padding: 16px 0; border-bottom: 1px solid var(--border);
  transition: opacity 0.15s;
}
.sl-mobile-menu-nav a:first-child { border-top: 1px solid var(--border); }
.sl-mobile-menu-nav a:hover { opacity: 0.45; }
.sl-mobile-menu-cta { padding: 24px; border-top: 1px solid var(--border); }
.sl-mobile-menu-cta button {
  width: 100%; background: var(--black); color: var(--white);
  border: none; padding: 16px; font-family: var(--font-body);
  font-size: 14px; font-weight: 600; cursor: pointer; border-radius: 4px;
  transition: background 0.15s;
}
.sl-mobile-menu-cta button:hover { background: #222; }
body.sl-menu-open { overflow: hidden; }

/* STICKY ADD TO CART */
#sl-sticky-atc {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-top: 1px solid var(--border);
  box-shadow: 0 -4px 24px rgba(0,0,0,0.10);
  z-index: 400;
  padding: 12px 24px;
  display: none;
  font-family: var(--font-body);
}
#sl-sticky-atc.visible { display: block; }
.sl-sticky-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.sl-sticky-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.sl-sticky-name {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sl-sticky-qty {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  background: var(--lavender-light);
  color: var(--black);
  padding: 2px 8px;
  border-radius: 20px;
  vertical-align: middle;
  margin-left: 2px;
}
.sl-sticky-price {
  font-size: 13px;
  color: var(--gray-mid);
}
.sl-sticky-btn {
  flex-shrink: 0;
  background: var(--black);
  color: var(--white);
  border: none;
  border-radius: 4px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  padding: 12px 28px;
  cursor: pointer;
  transition: background 0.15s;
  white-space: nowrap;
}
.sl-sticky-btn:hover { background: #222; }
.sl-sticky-btn:disabled { opacity: 0.6; cursor: default; }
@media (max-width: 480px) {
  #sl-sticky-atc { padding: 10px 16px; }
  .sl-sticky-btn { padding: 11px 18px; font-size: 13px; }
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .sl-product-hero, .sl-clinical, .sl-product-details, .sl-faq-section { grid-template-columns: 1fr; }
  .sl-product-info { padding: 28px 20px 40px; }
  .sl-stats-grid { grid-template-columns: 1fr 1fr; }
  .sl-nav { padding: 0 20px; }
  .sl-gallery-main { touch-action: pan-y; }
  .sl-slide-img { pointer-events: none; user-select: none; -webkit-user-select: none; }
}
</style>

<div class="sl-wrap">
