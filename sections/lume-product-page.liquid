          {%- endfor -%}
        {%- else -%}
          <a class="lm-drawer-link" href="{{ shop.url }}">Inicio</a>
          <a class="lm-drawer-link" href="{{ shop.url }}/collections/all">Todos los productos</a>
        {%- endif -%}
      </div>
    </div>
    <nav class="lm-header-nav">
      <a class="lm-hn-link" href="#lm-prod-{{ lm }}">{{ section.settings.nav1 }}</a>
