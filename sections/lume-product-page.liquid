  <!-- CAROUSEL -->
  <div class="lm-carousel" id="lm-car-{{ lm }}">
    <div class="lm-car-track" id="lm-track-{{ lm }}">
      {%- if lm_slides.size > 0 -%}
        {%- for block in lm_slides -%}
          <div class="lm-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1080 }}" alt="Slide {{ forloop.index }}" loading="{{ forloop.first | iif: 'eager', 'lazy' }}">
            {%- else -%}
              <div class="lm-slide-ph">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#C4BAB0" stroke-width="0.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <p>Imagen {{ forloop.index }} · 430 × 440 px</p>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <div class="lm-slide">
            <div class="lm-slide-ph">
              <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#C4BAB0" stroke-width="0.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <p>Foto {{ i }} · 430 × 440 px</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <button class="lm-cprev" id="lm-prev-{{ lm }}">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lm-cnext" id="lm-next-{{ lm }}">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lm-counter" id="lm-ctr-{{ lm }}">1 / {{ lm_total }}</div>
  </div>

  <!-- THUMBNAILS -->
  <div class="lm-thumbs" id="lm-thumbs-{{ lm }}">
    {%- if lm_slides.size > 0 -%}
      {%- for block in lm_slides -%}
        <div class="lm-thumb{% if forloop.first %} on{% endif %}" data-idx="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 108 }}" alt="">
          {%- else -%}
            <div class="lm-thumb-ph">{{ forloop.index }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..5) -%}
        <div class="lm-thumb{% if forloop.first %} on{% endif %}" data-idx="{{ forloop.index0 }}">
          <div class="lm-thumb-ph">{{ i }}</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- INFO -->
  <div class="lm-info" id="lm-prod-{{ lm }}">
    <p class="lm-info-brand">{{ section.settings.brand_text }}</p>
    <h1 class="lm-info-name">
      {{ section.settings.product_name }}
      <em>{{ section.settings.product_name_em }}</em>
    </h1>
    <p class="lm-info-subtitle">{{ section.settings.product_subtitle }}</p>
    <div class="lm-rating-row">
      <span class="lm-stars">★★★★★</span>
      <span class="lm-r-num">{{ section.settings.rating_num }}</span>
      <span class="lm-r-cnt">{{ section.settings.rating_count }}</span>
    </div>
    <div class="lm-price-wrap">
      <span class="lm-price-now" id="lm-pmain-{{ lm }}"></span>
      <span class="lm-price-was" id="lm-pwas-{{ lm }}"  style="display:none"></span>
      <span class="lm-price-tag" id="lm-ptag-{{ lm }}"  style="display:none"></span>
    </div>
    <p class="lm-info-desc">{{ section.settings.product_desc }}</p>
  </div>

  <div class="lm-divider"></div>

  <!-- PACKS -->
  <div class="lm-packs-wrap" id="lm-buy-{{ lm }}">
    <p class="lm-section-label">{{ section.settings.packs_label }}</p>
    <div class="lm-packs">
      {%- if lm_packs.size > 0 -%}
        {%- for block in lm_packs -%}
          <div class="lm-pack{% if block.settings.selected %} on{% endif %}"
               data-price="{{ block.settings.price_raw }}"
               data-was="{{ block.settings.old_price_raw }}"
               data-save="{{ block.settings.save_text }}"
               data-qty="{{ block.settings.qty_label }}"
               data-name="{{ block.settings.name | escape }}"
               data-variant="{{ block.settings.variant_id }}"
               data-img="{%- if block.settings.pack_image != blank -%}{{ block.settings.pack_image | image_url: width: 120 }}{%- endif -%}"
               {{ block.shopify_attributes }}>
            {%- if block.settings.badge != "none" -%}
              <span class="lm-p-badge {{ block.settings.badge }}">
                {%- if block.settings.badge_label != blank -%}
                  {{ block.settings.badge_label }}
                {%- elsif block.settings.badge == "popular" -%}
                  {{ section.settings.badge_popular_text }}
                {%- else -%}
                  {{ section.settings.badge_best_text }}
                {%- endif -%}
              </span>
            {%- endif -%}
            <div class="lm-p-radio"><div class="lm-p-dot"></div></div>
            <div class="lm-p-row">
              <span class="lm-p-name">{{ block.settings.name }}</span>
              <div class="lm-p-prices">
                <div class="lm-p-price">{{ block.settings.price_display }}</div>
                {%- if block.settings.unit_text != blank -%}<div class="lm-p-unit">{{ block.settings.unit_text }}</div>{%- endif -%}
                {%- if block.settings.old_price_display != blank -%}<div class="lm-p-old">{{ block.settings.old_price_display }}</div>{%- endif -%}
              </div>
              {%- if block.settings.pack_image != blank -%}
                <img class="lm-p-img" src="{{ block.settings.pack_image | image_url: width: 120 }}" alt="{{ block.settings.name }}" loading="lazy">
              {%- endif -%}
            </div>
            {%- if block.settings.desc != blank -%}<p class="lm-p-desc">{{ block.settings.desc }}</p>{%- endif -%}
            {%- if block.settings.save_text != blank -%}<span class="lm-p-save">{{ block.settings.save_text }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <p style="font-size:0.8rem;color:var(--text-light);padding:1rem 0;">Agrega bloques "Pack" desde el editor del customizador.</p>
      {%- endif -%}
    </div>
  </div>

  <!-- ORDER BAR -->
  <div class="lm-order-bar">
    <img class="lm-ob-img" id="lm-obimg-{{ lm }}" src="" alt="" loading="lazy">
    <div class="lm-ob-left">
      <span class="lm-ob-title" id="lm-obtitle-{{ lm }}"></span>
      <span class="lm-ob-sub">{{ section.settings.ob_sub }}</span>
      <span class="lm-ob-save"  id="lm-obsave-{{ lm }}"></span>
    </div>
    <div class="lm-ob-price" id="lm-obprice-{{ lm }}"></div>
  </div>

  <!-- CTA -->
  <div class="lm-cta-wrap">
    <button class="lm-btn-cart" id="lm-bcart-{{ lm }}">{{ section.settings.btn_cart_text }}</button>
    <button class="lm-btn-now"  id="lm-bnow-{{ lm }}">{{ section.settings.btn_now_text }}</button>
    <div class="lm-cta-trust">
      <div class="lm-ct-item">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        {{ section.settings.trust1 }}
      </div>
      <div class="lm-ct-item">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
        {{ section.settings.trust2 }}
      </div>
      <div class="lm-ct-item">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {{ section.settings.trust3 }}
      </div>
    </div>
  </div>

  <div class="lm-divider"></div>

  <!-- FEATURES -->
  <div class="lm-features" id="lm-res-{{ lm }}">
    {%- if lm_feats.size > 0 -%}
      {%- for block in lm_feats -%}
        <div class="lm-feat" {{ block.shopify_attributes }}>
          <div class="lm-feat-ico">
            {%- case block.settings.icon -%}
              {%- when "clock" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {%- when "activity" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              {%- when "shield" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- when "dollar" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
              {%- when "heart" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
              {%- when "star" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- when "leaf" -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M11 20A7 7 0 014 13c0-5.47 3.07-9 9-12 5.93 3 9 6.53 9 12a7 7 0 01-7 7z"/><path d="M12 20V8"/></svg>
              {%- else -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {%- endcase -%}
          </div>
          <div class="lm-feat-text">
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.desc }}</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <p style="padding:1rem 1.2rem;font-size:0.8rem;color:var(--text-light);">Agrega bloques "Característica" desde el editor.</p>
    {%- endif -%}
  </div>

  <div class="lm-divider"></div>

  <!-- TABS -->
  <div class="lm-tabs-wrap" id="lm-uso-{{ lm }}">
    <div class="lm-tabs">
      <button class="lm-tab-btn on" data-tab="desc">{{ section.settings.tab1_label }}</button>
      <button class="lm-tab-btn"    data-tab="uso">{{ section.settings.tab2_label }}</button>
      <button class="lm-tab-btn"    data-tab="envio">{{ section.settings.tab3_label }}</button>
    </div>
    <div class="lm-tab-panel on" id="lm-tdesc-{{ lm }}">
      <div class="lm-tab-body">{{ section.settings.tab_desc_text }}</div>
      {%- if lm_accs.size > 0 -%}
        <div class="lm-acc">
          {%- for block in lm_accs -%}
            <div class="lm-acc-item" {{ block.shopify_attributes }}>
              <div class="lm-acc-head">
                <span class="lm-acc-title">{{ block.settings.title }}</span>
                <span class="lm-acc-arr">▾</span>
              </div>
              <div class="lm-acc-body"><div class="lm-acc-inner">{{ block.settings.content }}</div></div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="lm-tab-panel" id="lm-tuso-{{ lm }}">
      {%- if lm_steps.size > 0 -%}
        <div class="lm-steps">
          {%- for block in lm_steps -%}
            <div class="lm-step-item" {{ block.shopify_attributes }}>
              <span class="lm-step-n">{{ forloop.index | prepend: "0" | slice: -2, 2 }}</span>
              <div class="lm-step-t">
                <strong>{{ block.settings.title }}</strong>
                <p>{{ block.settings.desc }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p style="font-size:0.8rem;color:var(--text-light);">Agrega bloques "Paso" desde el editor.</p>
      {%- endif -%}
    </div>
    <div class="lm-tab-panel" id="lm-tenvio-{{ lm }}">
      <div class="lm-tab-body">{{ section.settings.tab_shipping_text }}</div>
    </div>
  </div>

  <div class="lm-divider"></div>

  <!-- GUARANTEE -->
  <div class="lm-guarantee">
    <div class="lm-g-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
    <div>
      <p class="lm-g-title">{{ section.settings.guarantee_title }}</p>
      <p class="lm-g-text">{{ section.settings.guarantee_text }}</p>
    </div>
  </div>

  <div class="lm-divider"></div>

  <!-- REVIEWS -->
  <div class="lm-reviews-wrap" id="lm-rev-{{ lm }}">
    <div class="lm-rv-header">
      <div class="lm-rv-big">{{ section.settings.rv_score }}</div>
      <div class="lm-rv-right">
        <div class="lm-rv-stars">★★★★★</div>
        <div class="lm-rv-count">{{ section.settings.rv_total }}</div>
        <div class="lm-rv-bars">
          <div class="lm-rv-bar-r"><span class="lm-rv-bar-n">5</span><div class="lm-rv-bar-bg"><div class="lm-rv-bar-fill" style="width:{{ section.settings.rv_pct_5 }}%"></div></div></div>
          <div class="lm-rv-bar-r"><span class="lm-rv-bar-n">4</span><div class="lm-rv-bar-bg"><div class="lm-rv-bar-fill" style="width:{{ section.settings.rv_pct_4 }}%"></div></div></div>
          <div class="lm-rv-bar-r"><span class="lm-rv-bar-n">3</span><div class="lm-rv-bar-bg"><div class="lm-rv-bar-fill" style="width:{{ section.settings.rv_pct_3 }}%"></div></div></div>
          <div class="lm-rv-bar-r"><span class="lm-rv-bar-n">2</span><div class="lm-rv-bar-bg"><div class="lm-rv-bar-fill" style="width:{{ section.settings.rv_pct_2 }}%"></div></div></div>
          <div class="lm-rv-bar-r"><span class="lm-rv-bar-n">1</span><div class="lm-rv-bar-bg"><div class="lm-rv-bar-fill" style="width:{{ section.settings.rv_pct_1 }}%"></div></div></div>
        </div>
      </div>
    </div>
    {%- if lm_revs.size > 0 -%}
      {%- for block in lm_revs -%}
        {%- assign star_num = block.settings.stars | times: 1 -%}
        <div class="lm-review" {{ block.shopify_attributes }}>
          <div class="lm-rv-top">
            <span class="lm-rv-name">{{ block.settings.name }}</span>
            <span class="lm-rv-date">{{ block.settings.date }}</span>
          </div>
          <div class="lm-rv-stars-s">{%- for i in (1..5) -%}{%- if i <= star_num -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</div>
          <p class="lm-rv-text">"{{ block.settings.text }}"</p>
          {%- assign rv_has_imgs = false -%}
          {%- if block.settings.rv_img1 != blank or block.settings.rv_img2 != blank or block.settings.rv_img3 != blank -%}
            {%- assign rv_has_imgs = true -%}
          {%- endif -%}
          {%- if rv_has_imgs -%}
            <div class="lm-rv-imgs">
              {%- if block.settings.rv_img1 != blank -%}<img class="lm-rv-img" src="{{ block.settings.rv_img1 | image_url: width: 200 }}" alt="" loading="lazy">{%- endif -%}
              {%- if block.settings.rv_img2 != blank -%}<img class="lm-rv-img" src="{{ block.settings.rv_img2 | image_url: width: 200 }}" alt="" loading="lazy">{%- endif -%}
              {%- if block.settings.rv_img3 != blank -%}<img class="lm-rv-img" src="{{ block.settings.rv_img3 | image_url: width: 200 }}" alt="" loading="lazy">{%- endif -%}
            </div>
          {%- endif -%}
          <div class="lm-rv-verified">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            {{ section.settings.rv_verified_label }} · {{ block.settings.location }}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <p style="padding:1rem 1.2rem;font-size:0.8rem;color:var(--text-light);">Agrega bloques "Reseña" desde el editor.</p>
    {%- endif -%}
  </div>

  <!-- TIKTOK VIDEOS -->
  {%- assign lm_vids = section.blocks | where: "type", "video_item" -%}
  {%- if lm_vids.size > 0 -%}
  <div class="lm-tv-wrap" id="lm-tv-{{ lm }}">
    {%- if section.settings.tv_title != blank or section.settings.tv_subtitle != blank -%}
    <div class="lm-tv-head">
      {%- if section.settings.tv_title != blank -%}<p class="lm-tv-title">{{ section.settings.tv_title }}</p>{%- endif -%}
      {%- if section.settings.tv_subtitle != blank -%}<p class="lm-tv-subtitle">{{ section.settings.tv_subtitle }}</p>{%- endif -%}
    </div>
    {%- endif -%}
    <div class="lm-tv-carousel" id="lm-tv-car-{{ lm }}">
      <div class="lm-tv-track" id="lm-tv-trk-{{ lm }}">
        {%- for block in lm_vids -%}
        <div class="lm-tv-item" id="lm-tv-it-{{ lm }}-{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="lm-tv-card">
            <div class="lm-tv-aspect">
              {%- if block.settings.video != blank -%}
                <video class="lm-tv-video" playsinline muted loop
                  {%- if block.settings.thumbnail != blank %} poster="{{ block.settings.thumbnail | image_url: width: 540 }}"{% endif %}>
                  {%- for src in block.settings.video.sources -%}
                    <source src="{{ src.url }}" type="{{ src.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif block.settings.video_url != blank -%}
                <video class="lm-tv-video" playsinline muted loop
                  src="{{ block.settings.video_url }}"
                  {%- if block.settings.thumbnail != blank %} poster="{{ block.settings.thumbnail | image_url: width: 540 }}"{% endif %}>
                </video>
              {%- elsif block.settings.thumbnail != blank -%}
                <img class="lm-tv-thumb" src="{{ block.settings.thumbnail | image_url: width: 540 }}" alt="{{ block.settings.caption }}" loading="lazy">
              {%- endif -%}
              <div class="lm-tv-overlay">
                {%- if block.settings.username != blank -%}<p class="lm-tv-user">{{ block.settings.username }}</p>{%- endif -%}
                {%- if block.settings.caption != blank -%}<p class="lm-tv-caption">{{ block.settings.caption }}</p>{%- endif -%}
              </div>
              <div class="lm-tv-play-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </div>
              <button class="lm-tv-mute" id="lm-tv-mute-{{ lm }}-{{ forloop.index0 }}" aria-label="Silencio">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
              </button>
              <div class="lm-tv-progress"><div class="lm-tv-bar" id="lm-tv-bar-{{ lm }}-{{ forloop.index0 }}"></div></div>
            </div>
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="lm-tv-dots" id="lm-tv-dots-{{ lm }}">
      {%- for block in lm_vids -%}
        <button class="lm-tv-dot{% if forloop.first %} on{% endif %}" data-idx="{{ forloop.index0 }}" aria-label="Video {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  <!-- CLIENTAS FELICES -->
  {%- if lm_cfcards.size > 0 -%}
  <div class="lm-cf-wrap" id="lm-cf-{{ lm }}">
    <div class="lm-cf-top">
      {%- if section.settings.cf_badge_text != blank -%}
      <div><span class="lm-cf-badge"><span class="lm-cf-badge-stars">★★★★★</span>{{ section.settings.cf_badge_text }}</span></div>
      {%- endif -%}
      <h2 class="lm-cf-heading">
        {%- if section.settings.cf_title_dark != blank -%}<span class="lm-cf-heading-dark">{{ section.settings.cf_title_dark }} </span>{%- endif -%}
        {%- if section.settings.cf_title_gold != blank -%}<span class="lm-cf-heading-gold">{{ section.settings.cf_title_gold }}</span>{%- endif -%}
      </h2>
    </div>
    <div class="lm-cf-grid">
      {%- for block in lm_cfcards -%}
      {%- assign cf_stars = block.settings.stars | plus: 0 -%}
      <div class="lm-cf-card" {{ block.shopify_attributes }}>
        <div class="lm-cf-img-wrap">
          {%- if block.settings.image != blank -%}
            <img class="lm-cf-img" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" loading="lazy">
          {%- else -%}
            <div class="lm-cf-img-ph"></div>
          {%- endif -%}
        </div>
        <div class="lm-cf-body">
          <div class="lm-cf-card-stars">{%- for i in (1..5) -%}{%- if i <= cf_stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}</div>
          <div class="lm-cf-meta">
            <span class="lm-cf-name">{{ block.settings.name }}{%- if block.settings.age != blank -%},&nbsp;{{ block.settings.age }}{%- endif -%}</span>
            {%- if block.settings.verified_label != blank -%}
            <span class="lm-cf-vf"><span class="lm-cf-vf-dot"></span>{{ block.settings.verified_label }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.text != blank -%}
          <p class="lm-cf-text">"{{ block.settings.text }}"</p>
          {%- endif -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  <!-- FOOTER -->
  <div class="lm-footer">
    <div class="lm-ft-top">
      <div class="lm-ft-logo">
        {%- if section.settings.footer_logo != blank -%}
          <img src="{{ section.settings.footer_logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- elsif section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
        {%- else -%}
          <div class="lm-ft-logo-ph">{{ section.settings.logo_text }}</div>
        {%- endif -%}
      </div>
      <p class="lm-ft-tag">{{ section.settings.footer_tagline }}</p>
      <div class="lm-ft-social">
        {%- if section.settings.footer_instagram != blank -%}
          <a class="lm-ft-soc" href="{{ section.settings.footer_instagram }}" target="_blank" rel="noopener">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(184,150,90,0.55)" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="rgba(184,150,90,0.55)" stroke="none"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.footer_tiktok != blank -%}
          <a class="lm-ft-soc" href="{{ section.settings.footer_tiktok }}" target="_blank" rel="noopener">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(184,150,90,0.55)" stroke-width="1.5"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="lm-ft-cols">
      <div class="lm-ft-col">
        <p class="lm-ft-col-title">{{ section.settings.footer_col1_title }}</p>
        {%- assign ft_menu1 = linklists[section.settings.footer_menu1] -%}
        {%- if ft_menu1.links.size > 0 -%}
          <ul class="lm-ft-links">
            {%- for link in ft_menu1.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        {%- elsif lm_fc1.size > 0 -%}
          <ul class="lm-ft-links">
            {%- for block in lm_fc1 -%}<li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="lm-ft-col">
        <p class="lm-ft-col-title">{{ section.settings.footer_col2_title }}</p>
        {%- assign ft_menu2 = linklists[section.settings.footer_menu2] -%}
        {%- if ft_menu2.links.size > 0 -%}
          <ul class="lm-ft-links">
            {%- for link in ft_menu2.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        {%- elsif lm_fc2.size > 0 -%}
          <ul class="lm-ft-links">
            {%- for block in lm_fc2 -%}<li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
    <div class="lm-ft-payments">
      <p class="lm-ft-pay-title">{{ section.settings.footer_pay_title }}</p>
      <div class="lm-ft-pay-methods">
        {%- assign pay_methods = section.settings.footer_payments | split: "," -%}
        {%- for method in pay_methods -%}<span class="lm-pay-chip">{{ method | strip }}</span>{%- endfor -%}
      </div>
    </div>
    <div class="lm-ft-bottom">
      <p class="lm-ft-copy">{{ section.settings.footer_copyright }}</p>
      <div class="lm-ft-legal">
        {%- if section.settings.footer_privacy_url != blank -%}<a href="{{ section.settings.footer_privacy_url }}">{{ section.settings.footer_privacy_label }}</a>{%- endif -%}
        {%- if section.settings.footer_terms_url != blank -%}<a href="{{ section.settings.footer_terms_url }}">{{ section.settings.footer_terms_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_atc_enabled -%}
  <div class="lm-sticky-atc" id="lm-sticky-{{ lm }}">
    <div class="lm-sticky-info">
      <span class="lm-sticky-name" id="lm-sname-{{ lm }}">{{ section.settings.product_name }}</span>
      <span class="lm-sticky-price" id="lm-sprice-{{ lm }}"></span>
    </div>
    <button class="lm-sticky-btn" id="lm-sbtn-{{ lm }}">{{ section.settings.sticky_btn_text }}</button>
  </div>
  {%- endif -%}

  <div class="lm-toast" id="lm-toast-{{ lm }}"></div>
</div>

<script>
(function(){
  var S = document.getElementById('lume-pg-{{ lm }}');
  if(!S) return;

  /* ANN BAR */
  var ann = S.querySelector('#lm-ann-{{ lm }}');
  if(ann){
    var annS = ann.querySelectorAll('.lm-ann-slide'), ai=0;
    setInterval(function(){ ai=(ai+1)%annS.length; ann.style.transform='translateY(-'+ai*34+'px)'; },3500);
  }

  /* CAROUSEL */
  var track   = S.querySelector('#lm-track-{{ lm }}');
  var ctrEl   = S.querySelector('#lm-ctr-{{ lm }}');
  var thumbs  = S.querySelectorAll('#lm-thumbs-{{ lm }} .lm-thumb');
  var total   = {{ lm_total }}, cur = 0;
  function lmGo(n){
    cur=((n%total)+total)%total;
    track.style.transform='translateX(-'+cur*100+'%)';
    thumbs.forEach(function(t,i){ t.classList.toggle('on',i===cur); });
    if(ctrEl) ctrEl.textContent=(cur+1)+' / '+total;
  }
  S.querySelector('#lm-prev-{{ lm }}').addEventListener('click',function(){ lmGo(cur-1); });
  S.querySelector('#lm-next-{{ lm }}').addEventListener('click',function(){ lmGo(cur+1); });
  thumbs.forEach(function(t){ t.addEventListener('click',function(){ lmGo(parseInt(t.dataset.idx)||0); }); });
  var carEl=S.querySelector('#lm-car-{{ lm }}'), sx=0;
  if(carEl){
    carEl.addEventListener('touchstart',function(e){ sx=e.touches[0].clientX; },{passive:true});
    carEl.addEventListener('touchend',  function(e){ var dx=e.changedTouches[0].clientX-sx; if(Math.abs(dx)>40) lmGo(dx<0?cur+1:cur-1); },{passive:true});
  }

  /* TOAST */
  var toastEl=S.querySelector('#lm-toast-{{ lm }}');
  function lmToast(msg){ if(!toastEl) return; toastEl.textContent=msg; toastEl.classList.add('show'); setTimeout(function(){ toastEl.classList.remove('show'); },2500); }

  /* PACKS */
  function lmFmt(n){ var v=parseFloat(n); return v?'$'+v.toLocaleString('es-CL'):''; }
  function lmPick(el){
    S.querySelectorAll('.lm-pack').forEach(function(p){ p.classList.remove('on'); });
    el.classList.add('on');
    var price=el.dataset.price||'', was=el.dataset.was||'', save=el.dataset.save||'', qty=el.dataset.qty||'';
    var pm=S.querySelector('#lm-pmain-{{ lm }}'), pw=S.querySelector('#lm-pwas-{{ lm }}'), pt=S.querySelector('#lm-ptag-{{ lm }}');
    var op=S.querySelector('#lm-obprice-{{ lm }}'), ot=S.querySelector('#lm-obtitle-{{ lm }}'), os=S.querySelector('#lm-obsave-{{ lm }}');
    if(pm) pm.textContent=lmFmt(price);
    if(op) op.textContent=lmFmt(price);
    if(ot) ot.textContent=qty;
    if(os) os.textContent=save;
    if(pw){ if(was&&parseFloat(was)>0){ pw.textContent=lmFmt(was); pw.style.display=''; } else pw.style.display='none'; }
    if(pt){ if(was&&price&&parseFloat(was)>0){ pt.textContent='-'+Math.round((1-parseFloat(price)/parseFloat(was))*100)+'%'; pt.style.display=''; } else pt.style.display='none'; }
    var sn=S.querySelector('#lm-sname-{{ lm }}'), sp=S.querySelector('#lm-sprice-{{ lm }}');
    if(sn) sn.textContent=el.dataset.name||el.dataset.qty||'';
    if(sp) sp.textContent=lmFmt(price);
    var oi=S.querySelector('#lm-obimg-{{ lm }}');
    if(oi){ var imgSrc=el.dataset.img||''; oi.src=imgSrc; oi.alt=el.dataset.name||''; }
  }
  S.querySelectorAll('.lm-pack').forEach(function(p){ p.addEventListener('click',function(){ lmPick(p); }); });
  var initP=S.querySelector('.lm-pack.on')||S.querySelector('.lm-pack');
  if(initP) lmPick(initP);

  /* CART */
  S.querySelector('#lm-bcart-{{ lm }}').addEventListener('click',async function(){
    var ap=S.querySelector('.lm-pack.on'), vid=ap?ap.dataset.variant:null;
    if(!vid||!vid.trim()){ lmToast('Configura el Variant ID en el editor'); return; }
    try{
      var r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:parseInt(vid),quantity:1})});
      if(r.ok){
        lmToast('{{ section.settings.toast_cart | escape }}');
        var dot=S.querySelector('#lm-cdot-{{ lm }}');
        if(dot){ dot.textContent=(parseInt(dot.textContent)||0)+1; dot.style.display='flex'; }
      } else { var e=await r.json(); lmToast(e.description||'Error al agregar'); }
    } catch(e){ lmToast('Error de conexión'); }
  });
  S.querySelector('#lm-bnow-{{ lm }}').addEventListener('click',function(){
    var ap=S.querySelector('.lm-pack.on'), vid=ap?ap.dataset.variant:null;
    if(!vid||!vid.trim()){ lmToast('Configura el Variant ID en el editor'); return; }
    window.location.href='/cart/'+vid+':1';
  });

  /* TABS */
  S.querySelectorAll('.lm-tab-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      var id=btn.dataset.tab;
      S.querySelectorAll('.lm-tab-btn').forEach(function(b){ b.classList.remove('on'); });
      S.querySelectorAll('.lm-tab-panel').forEach(function(p){ p.classList.remove('on'); });
      btn.classList.add('on');
      var panel=S.querySelector('#lm-t'+id+'-{{ lm }}');
      if(panel) panel.classList.add('on');
    });
  });

  /* ACCORDION */
  S.querySelectorAll('.lm-acc-item').forEach(function(item){
    item.querySelector('.lm-acc-head').addEventListener('click',function(){ item.classList.toggle('open'); });
  });

  /* HAMBURGER DRAWER */
  var lmHam=document.getElementById('lm-ham-{{ lm }}');
  var lmDrw=document.getElementById('lm-drawer-{{ lm }}');
  var lmOvl=document.getElementById('lm-overlay-{{ lm }}');
  var lmDrwX=document.getElementById('lm-drw-close-{{ lm }}');
  function lmDrwClose(){ if(lmDrw) lmDrw.classList.remove('open'); if(lmOvl) lmOvl.classList.remove('show'); document.body.style.overflow=''; }
  function lmDrwOpen(){ if(lmDrw) lmDrw.classList.add('open'); if(lmOvl) lmOvl.classList.add('show'); document.body.style.overflow='hidden'; }
  if(lmHam){ lmHam.addEventListener('click', function(){ lmDrw&&lmDrw.classList.contains('open') ? lmDrwClose() : lmDrwOpen(); }); }
  if(lmDrwX){ lmDrwX.addEventListener('click', lmDrwClose); }
  if(lmOvl){ lmOvl.addEventListener('click', lmDrwClose); }
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') lmDrwClose(); });

  /* STICKY ATC */
  var lmSticky=document.getElementById('lm-sticky-{{ lm }}');
  var lmCtaRef=S.querySelector('.lm-cta-wrap');
  if(lmSticky&&lmCtaRef){
    function lmChkSticky(){ lmSticky.classList.toggle('show', lmCtaRef.getBoundingClientRect().bottom<0); }
    window.addEventListener('scroll',lmChkSticky,{passive:true});
    lmChkSticky();
    document.getElementById('lm-sbtn-{{ lm }}').addEventListener('click',async function(){
      var ap=S.querySelector('.lm-pack.on'), vid=ap?ap.dataset.variant:null;
      if(!vid||!vid.trim()){ lmToast('Configura el Variant ID en el editor'); return; }
      try{
        var r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:parseInt(vid),quantity:1})});
        if(r.ok){ lmToast('{{ section.settings.toast_cart | escape }}'); }
        else { var e=await r.json(); lmToast(e.description||'Error al agregar'); }
      } catch(e){ lmToast('Error de conexión'); }
    });
  }

  /* NAV SCROLL */
  S.querySelectorAll('.lm-hn-link').forEach(function(a){
    a.addEventListener('click',function(e){
      e.preventDefault();
      var target=S.querySelector(a.getAttribute('href'));
      if(!target) return;
      var hh=(S.querySelector('.lm-header')||{offsetHeight:0}).offsetHeight+34;
      window.scrollTo({top:target.getBoundingClientRect().top+window.scrollY-hh-8,behavior:'smooth'});
    });
  });
  var navIds=['lm-prod-{{ lm }}','lm-res-{{ lm }}','lm-uso-{{ lm }}','lm-rev-{{ lm }}','lm-buy-{{ lm }}'];
  var navLinks=S.querySelectorAll('.lm-hn-link');
  function onScroll(){
    var hh=(S.querySelector('.lm-header')||{offsetHeight:0}).offsetHeight+40, active=navIds[0];
    navIds.forEach(function(id){ var el=S.querySelector('#'+id); if(el&&el.getBoundingClientRect().top<=hh+20) active=id; });
    navLinks.forEach(function(l){ l.classList.toggle('active',l.getAttribute('href').replace('#','')==active); });
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  onScroll();

  /* TIKTOK VIDEOS */
  (function(){
    var tvWrap=document.getElementById('lm-tv-{{ lm }}');
    if(!tvWrap) return;
    var tvTrack=document.getElementById('lm-tv-trk-{{ lm }}');
    var tvDots=tvWrap.querySelectorAll('.lm-tv-dot');
    var tvItems=tvWrap.querySelectorAll('.lm-tv-item');
    var tvTotal=tvItems.length;
    if(!tvTotal||!tvTrack) return;
    var tvCur=0, tvMuted=true, tvSx=0, tvRaf={};
    var tvCardW={{ section.settings.tv_card_width }};
    function tvGo(n){
      n=((n%tvTotal)+tvTotal)%tvTotal;
      tvPauseAll(); tvCur=n;
      tvTrack.style.transform='translateX(-'+(tvCur*tvCardW)+'%)';
      tvDots.forEach(function(d,i){ d.classList.toggle('on',i===tvCur); });
      tvPlay(tvCur);
    }
    function tvPlay(idx){
      var item=tvItems[idx]; if(!item) return;
      var vid=item.querySelector('video'); if(!vid) return;
      vid.muted=tvMuted; vid.play().catch(function(){});
      item.classList.remove('paused'); tvStartProg(idx,vid);
    }
    function tvPauseAll(){
      tvItems.forEach(function(item,idx){
        var vid=item.querySelector('video');
        if(vid){ vid.pause(); tvStopProg(idx); }
        item.classList.add('paused');
      });
    }
    function tvStopProg(idx){ if(tvRaf[idx]){ cancelAnimationFrame(tvRaf[idx]); delete tvRaf[idx]; } }
    function tvStartProg(idx,vid){
      tvStopProg(idx);
      var bar=document.getElementById('lm-tv-bar-{{ lm }}-'+idx);
      if(!bar||!vid.duration) return;
      function tick(){ if(vid.paused||vid.ended) return; bar.style.width=(vid.currentTime/vid.duration*100)+'%'; tvRaf[idx]=requestAnimationFrame(tick); }
      vid.addEventListener('loadedmetadata',function(){ tvRaf[idx]=requestAnimationFrame(tick); },{once:true});
      if(vid.readyState>=1) tvRaf[idx]=requestAnimationFrame(tick);
    }
    tvItems.forEach(function(item,idx){
      item.querySelector('.lm-tv-card').addEventListener('click',function(e){
        if(e.target.closest('.lm-tv-mute')) return;
        var vid=item.querySelector('video'); if(!vid) return;
        if(vid.paused){ vid.play(); item.classList.remove('paused'); tvStartProg(idx,vid); }
        else { vid.pause(); item.classList.add('paused'); tvStopProg(idx); }
      });
    });
    var muteIconSvg='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';
    var unmuteIconSvg='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/></svg>';
    tvWrap.querySelectorAll('.lm-tv-mute').forEach(function(btn){
      btn.addEventListener('click',function(){
        tvMuted=!tvMuted;
        tvItems.forEach(function(item){ var vid=item.querySelector('video'); if(vid) vid.muted=tvMuted; });
        tvWrap.querySelectorAll('.lm-tv-mute').forEach(function(b){ b.innerHTML=tvMuted?muteIconSvg:unmuteIconSvg; });
      });
    });
    tvDots.forEach(function(d){ d.addEventListener('click',function(){ tvGo(parseInt(d.dataset.idx)); }); });
    tvTrack.addEventListener('touchstart',function(e){ tvSx=e.touches[0].clientX; },{passive:true});
    tvTrack.addEventListener('touchend',function(e){ var dx=e.changedTouches[0].clientX-tvSx; if(Math.abs(dx)>40) tvGo(dx<0?tvCur+1:tvCur-1); },{passive:true});
    tvGo(0);
    if('IntersectionObserver' in window){
      var tvIo=new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          var vid=e.target.querySelector('video'); if(!vid) return;
          if(e.isIntersecting){ if(e.target===tvItems[tvCur]) vid.play().catch(function(){}); }
          else { vid.pause(); }
        });
      },{threshold:0.4});
      tvItems.forEach(function(item){ tvIo.observe(item); });
    }
  })();
})();
</script>

{% schema %}
{
  "name": "Lumé Product Page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "🎨 Colores" },
    { "type": "color", "id": "color_gold",      "label": "Dorado principal",     "default": "#B8965A" },
    { "type": "color", "id": "color_gold_light", "label": "Dorado claro",         "default": "#D9BF8C" },
    { "type": "color", "id": "color_gold_faint", "label": "Dorado muy claro",     "default": "#F0E6D0" },
    { "type": "color", "id": "color_gold_dark",  "label": "Dorado oscuro",        "default": "#7A6035" },
    { "type": "color", "id": "color_ink",        "label": "Tinta / fondo oscuro", "default": "#141210" },
    { "type": "color", "id": "color_ink_soft",   "label": "Tinta suave",          "default": "#2A2620" },
    { "type": "color", "id": "color_cream",      "label": "Crema (fondo página)", "default": "#F8F5F0" },
    { "type": "color", "id": "color_cream_mid",  "label": "Crema media",          "default": "#EDE8DF" },
    { "type": "color", "id": "color_cream_dark", "label": "Crema oscura",         "default": "#E4DDD1" },
    { "type": "color", "id": "color_warm_white", "label": "Blanco cálido",        "default": "#FDFBF8" },
    { "type": "color", "id": "color_text",       "label": "Texto principal",      "default": "#302C27" },
    { "type": "color", "id": "color_text_mid",   "label": "Texto medio",          "default": "#6B6459" },
    { "type": "color", "id": "color_text_light", "label": "Texto claro",          "default": "#9C9488" },
    { "type": "color", "id": "color_green",      "label": "Verde (ahorro)",       "default": "#3D6648" },
    { "type": "color", "id": "color_green_bg",   "label": "Fondo verde",          "default": "#EDF2EE" },

    { "type": "header", "content": "🖼️ Logo" },
    { "type": "image_picker", "id": "logo",        "label": "Logo (header)" },
    { "type": "text",         "id": "logo_text",   "label": "Texto si no hay logo", "default": "Lumé" },
    { "type": "range",        "id": "logo_height", "label": "Altura del logo", "min": 16, "max": 80, "step": 1, "default": 28, "unit": "px" },
    { "type": "url",          "id": "logo_url",    "label": "Destino al hacer clic en el logo" },

    { "type": "header", "content": "☰ Menú de categorías (drawer)" },
    { "type": "link_list", "id": "header_menu", "label": "Menú de categorías", "info": "Selecciona el menú de Shopify que aparece al abrir el drawer lateral" },

    { "type": "header", "content": "📢 Barra de anuncios" },
    { "type": "color",  "id": "ann_bg_color",   "label": "Fondo de la barra",  "default": "#141210" },
    { "type": "color",  "id": "ann_text_color", "label": "Color del texto",    "default": "#D9BF8C" },
    { "type": "color",  "id": "ann_icon_color", "label": "Color del icono",    "default": "#B8965A" },
    { "type": "text",   "id": "ann1_text",      "label": "Anuncio 1",          "default": "Envío gratis en todo Chile en todos los pedidos" },
    { "type": "text",   "id": "ann2_text",      "label": "Anuncio 2",          "default": "Garantía de satisfacción 30 días — devolución sin preguntas" },

    { "type": "header", "content": "🧭 Navegación" },
    { "type": "text", "id": "nav1", "label": "Nav 1", "default": "Producto" },
    { "type": "text", "id": "nav2", "label": "Nav 2", "default": "Cómo usar" },
    { "type": "text", "id": "nav3", "label": "Nav 3", "default": "Resultados" },
    { "type": "text", "id": "nav4", "label": "Nav 4", "default": "Reseñas" },
    { "type": "text", "id": "nav5", "label": "Nav 5", "default": "Comprar" },

    { "type": "header", "content": "🗂️ Breadcrumb" },
    { "type": "text", "id": "bc_home",     "label": "Inicio — texto",    "default": "Inicio" },
    { "type": "url",  "id": "bc_home_url", "label": "Inicio — destino URL" },
    { "type": "text", "id": "bc_cat",     "label": "Categoría", "default": "Cepillos" },
    { "type": "text", "id": "bc_product", "label": "Producto",  "default": "Lumé Facial Brush" },

    { "type": "header", "content": "📦 Información del producto" },
    { "type": "text",     "id": "brand_text",       "label": "Marca",                "default": "Lumé · Skincare Tools" },
    { "type": "text",     "id": "product_name",     "label": "Nombre del producto",  "default": "Facial Brush" },
    { "type": "text",     "id": "product_name_em",  "label": "Subtítulo en cursiva", "default": "Drenaje Linfático" },
    { "type": "text",     "id": "product_subtitle", "label": "Subtítulo pequeño",    "default": "Cepillo de drenaje linfático · Uso en seco" },
