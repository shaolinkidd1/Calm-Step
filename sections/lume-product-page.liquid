{%- assign lm = section.id -%}
{%- assign lm_slides = section.blocks | where: "type", "slide" -%}
{%- assign lm_packs  = section.blocks | where: "type", "pack" -%}
{%- assign lm_feats  = section.blocks | where: "type", "feature" -%}
{%- assign lm_steps  = section.blocks | where: "type", "step" -%}
{%- assign lm_accs   = section.blocks | where: "type", "accordion" -%}
{%- assign lm_revs   = section.blocks | where: "type", "review" -%}
{%- assign lm_cfcards = section.blocks | where: "type", "cf_card" -%}
{%- assign lm_fc1    = section.blocks | where: "type", "footer_link_col1" -%}
{%- assign lm_fc2    = section.blocks | where: "type", "footer_link_col2" -%}
{%- assign lm_total  = lm_slides | size -%}
{%- if lm_total == 0 -%}{%- assign lm_total = 5 -%}{%- endif -%}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">

<style>
#lume-pg-{{ lm }} {
  --gold:        {{ section.settings.color_gold }};
  --gold-light:  {{ section.settings.color_gold_light }};
  --gold-faint:  {{ section.settings.color_gold_faint }};
  --gold-dark:   {{ section.settings.color_gold_dark }};
  --ink:         {{ section.settings.color_ink }};
  --ink-soft:    {{ section.settings.color_ink_soft }};
  --cream:       {{ section.settings.color_cream }};
  --cream-mid:   {{ section.settings.color_cream_mid }};
  --cream-dark:  {{ section.settings.color_cream_dark }};
  --warm-white:  {{ section.settings.color_warm_white }};
  --text:        {{ section.settings.color_text }};
  --text-mid:    {{ section.settings.color_text_mid }};
  --text-light:  {{ section.settings.color_text_light }};
  --border:      rgba(0,0,0,0.07);
  --border-warm: rgba(184,150,90,0.22);
  --green:       {{ section.settings.color_green }};
  --green-bg:    {{ section.settings.color_green_bg }};
  --sticky-bg:       {{ section.settings.sticky_bg }};
  --sticky-fg:       {{ section.settings.sticky_text_color }};
  --sticky-btn-bg:   {{ section.settings.sticky_btn_color }};
  --sticky-btn-fg:   {{ section.settings.sticky_btn_text_color }};
  --btn-radius:      {{ section.settings.btn_radius }}px;
  --tv-bg:           {{ section.settings.tv_bg_color }};
  --tv-fg:           {{ section.settings.tv_text_color }};
  --cf-bg:           {{ section.settings.cf_bg_color }};
  --ann-bg:          {{ section.settings.ann_bg_color }};
  --ann-fg:          {{ section.settings.ann_text_color }};
  --ann-icon:        {{ section.settings.ann_icon_color }};
}
#lume-pg-{{ lm }}, #lume-pg-{{ lm }} *, #lume-pg-{{ lm }} *::before, #lume-pg-{{ lm }} *::after { box-sizing: border-box; }
#lume-pg-{{ lm }} { font-family: 'Jost', sans-serif; background: var(--cream); color: var(--text); overflow-x: hidden; -webkit-font-smoothing: antialiased; }
/* ANN BAR */
#lume-pg-{{ lm }} .lm-ann { background: var(--ann-bg); height: 34px; overflow: hidden; position: relative; }
#lume-pg-{{ lm }} .lm-ann-track { display: flex; flex-direction: column; transition: transform 0.55s cubic-bezier(0.4,0,0.2,1); }
#lume-pg-{{ lm }} .lm-ann-slide { height: 34px; display: flex; align-items: center; justify-content: center; gap: 0.55rem; font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in srgb, var(--ann-fg) 55%, transparent); flex-shrink: 0; padding: 0 1rem; white-space: nowrap; }
#lume-pg-{{ lm }} .lm-ann-slide svg { flex-shrink: 0; color: var(--ann-icon); }
#lume-pg-{{ lm }} .lm-ann-slide strong { color: var(--ann-fg); font-weight: 400; }
#lume-pg-{{ lm }} .lm-ann-timer { font-variant-numeric: tabular-nums; color: var(--ann-fg); font-weight: 500; letter-spacing: 0.14em; font-size: 0.66rem; background: rgba(255,255,255,0.08); border: 0.5px solid rgba(255,255,255,0.18); padding: 0.1rem 0.45rem; }
/* HEADER */
#lume-pg-{{ lm }} .lm-header { background: var(--warm-white); border-bottom: 1px solid var(--border); position: relative; }
#lume-pg-{{ lm }} .lm-header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0.7rem 1.2rem; }
#lume-pg-{{ lm }} .lm-header-left  { display: flex; align-items: center; justify-content: flex-start; }
#lume-pg-{{ lm }} .lm-header-center{ display: flex; align-items: center; justify-content: center; }
#lume-pg-{{ lm }} .lm-header-right { display: flex; align-items: center; justify-content: flex-end; gap: 1.1rem; }
#lume-pg-{{ lm }} .lm-logo img { height: {{ section.settings.logo_height }}px; object-fit: contain; display: block; }
#lume-pg-{{ lm }} .lm-logo-ph { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 300; color: var(--ink); letter-spacing: 0.12em; }
#lume-pg-{{ lm }} .lm-hbtn { background: none; border: none; cursor: pointer; padding: 0; color: var(--ink); display: flex; align-items: center; position: relative; }
#lume-pg-{{ lm }} .lm-cart-dot { position: absolute; top: -3px; right: -4px; width: 14px; height: 14px; background: var(--gold); color: var(--ink); border-radius: 50%; font-size: 0.5rem; font-weight: 600; display: none; align-items: center; justify-content: center; }
/* HAMBURGER DRAWER */
#lume-pg-{{ lm }} .lm-drawer { position: fixed; top: 0; left: 0; width: 270px; height: 100vh; background: var(--warm-white); border-right: 1px solid var(--border); transform: translateX(-100%); transition: transform 0.32s cubic-bezier(0.4,0,0.2,1); z-index: 10000; overflow-y: auto; }
#lume-pg-{{ lm }} .lm-drawer.open { transform: translateX(0); }
#lume-pg-{{ lm }} .lm-drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.2rem; border-bottom: 1px solid var(--border); }
#lume-pg-{{ lm }} .lm-drawer-title { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-light); font-weight: 400; }
#lume-pg-{{ lm }} .lm-drawer-close { background: none; border: none; cursor: pointer; color: var(--text-mid); padding: 0; display: flex; align-items: center; }
#lume-pg-{{ lm }} .lm-drawer-inner { padding: 0.4rem 0 1rem; }
#lume-pg-{{ lm }} .lm-drawer-link { display: block; padding: 0.85rem 1.4rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mid); text-decoration: none; font-weight: 300; border-bottom: 1px solid var(--border); transition: color 0.2s, background 0.2s; }
#lume-pg-{{ lm }} .lm-drawer-link:last-child { border-bottom: none; }
#lume-pg-{{ lm }} .lm-drawer-link:hover { color: var(--ink); background: var(--cream); }
#lume-pg-{{ lm }} .lm-overlay { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.38); display: none; }
#lume-pg-{{ lm }} .lm-overlay.show { display: block; }
/* PAGE NAV */
#lume-pg-{{ lm }} .lm-header-nav { display: flex; border-top: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; background: var(--warm-white); }
#lume-pg-{{ lm }} .lm-header-nav::-webkit-scrollbar { display: none; }
#lume-pg-{{ lm }} .lm-hn-link { padding: 0.55rem 1rem; font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 400; color: var(--text-light); text-decoration: none; white-space: nowrap; border-bottom: 1.5px solid transparent; transition: color 0.2s, border-color 0.2s; }
#lume-pg-{{ lm }} .lm-hn-link.active { color: var(--ink); border-bottom-color: var(--gold); }
/* BREADCRUMB */
#lume-pg-{{ lm }} .lm-breadcrumb { padding: 0.55rem 1.2rem; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-light); display: flex; align-items: center; gap: 0.4rem; background: var(--cream); border-bottom: 1px solid var(--border); }
#lume-pg-{{ lm }} .lm-breadcrumb a { color: var(--text-light); text-decoration: none; }
#lume-pg-{{ lm }} .lm-breadcrumb span { color: var(--text-mid); }
/* CAROUSEL */
#lume-pg-{{ lm }} .lm-carousel { position: relative; background: var(--cream-mid); overflow: hidden; touch-action: pan-y; }
#lume-pg-{{ lm }} .lm-car-track { display: flex; transition: transform 0.42s cubic-bezier(0.25,0.46,0.45,0.94); will-change: transform; }
#lume-pg-{{ lm }} .lm-slide { flex: 0 0 100%; }
#lume-pg-{{ lm }} .lm-slide img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
#lume-pg-{{ lm }} .lm-slide-ph { width: 100%; aspect-ratio: 1/1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; background: var(--cream-mid); }
#lume-pg-{{ lm }} .lm-slide-ph p { font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-light); text-align: center; line-height: 2; margin: 0; padding: 0; }
#lume-pg-{{ lm }} .lm-counter { position: absolute; bottom: 0.9rem; right: 1rem; background: rgba(20,18,16,0.55); backdrop-filter: blur(8px); color: rgba(255,255,255,0.75); font-size: 0.58rem; letter-spacing: 0.12em; padding: 0.25rem 0.55rem; }
#lume-pg-{{ lm }} .lm-cprev, #lume-pg-{{ lm }} .lm-cnext { position: absolute; top: 50%; transform: translateY(-50%); background: none; border: none; padding: 0.4rem; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5; filter: drop-shadow(0 1px 4px rgba(0,0,0,0.55)); color: #fff; }
#lume-pg-{{ lm }} .lm-cprev { left: 0.6rem; }
#lume-pg-{{ lm }} .lm-cnext { right: 0.6rem; }
#lume-pg-{{ lm }} .lm-cprev svg, #lume-pg-{{ lm }} .lm-cnext svg { width: 22px; height: 22px; }
/* THUMBS */
#lume-pg-{{ lm }} .lm-thumbs { display: flex; gap: 5px; padding: 0.65rem 1.2rem; background: var(--warm-white); border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; }
#lume-pg-{{ lm }} .lm-thumbs::-webkit-scrollbar { display: none; }
#lume-pg-{{ lm }} .lm-thumb { width: 54px; height: 54px; flex-shrink: 0; border: 1.5px solid transparent; overflow: hidden; cursor: pointer; background: var(--cream-mid); display: flex; align-items: center; justify-content: center; transition: border-color 0.2s; }
#lume-pg-{{ lm }} .lm-thumb.on { border-color: var(--gold); }
#lume-pg-{{ lm }} .lm-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
#lume-pg-{{ lm }} .lm-thumb-ph { font-size: 0.48rem; color: var(--text-light); text-align: center; line-height: 1.5; }
/* INFO */
#lume-pg-{{ lm }} .lm-info { background: var(--warm-white); padding: 1.4rem 1.2rem 0.6rem; }
#lume-pg-{{ lm }} .lm-info-brand { font-size: 0.56rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold); font-weight: 400; margin-bottom: 0.7rem; display: flex; align-items: center; gap: 0.6rem; }
#lume-pg-{{ lm }} .lm-info-brand::before, #lume-pg-{{ lm }} .lm-info-brand::after { content: ''; flex: 1; height: 0.5px; background: var(--border-warm); max-width: 28px; }
#lume-pg-{{ lm }} .lm-info-name { font-family: 'Cormorant Garamond', serif; font-size: 2.05rem; font-weight: 300; line-height: 1.12; color: var(--ink); margin-bottom: 0.25rem; letter-spacing: 0.01em; }
#lume-pg-{{ lm }} .lm-info-name em { font-style: italic; font-weight: 400; color: var(--gold-dark); display: block; font-size: 1.55rem; letter-spacing: 0.04em; }
#lume-pg-{{ lm }} .lm-info-subtitle { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-light); font-weight: 300; margin-bottom: 0.7rem; }
#lume-pg-{{ lm }} .lm-rating-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
#lume-pg-{{ lm }} .lm-stars { color: var(--gold); font-size: 0.7rem; letter-spacing: 0.06em; }
#lume-pg-{{ lm }} .lm-r-num { font-size: 0.72rem; font-weight: 500; color: var(--ink); }
#lume-pg-{{ lm }} .lm-r-cnt { font-size: 0.68rem; color: var(--text-mid); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
#lume-pg-{{ lm }} .lm-price-wrap { display: flex; align-items: baseline; gap: 0.7rem; padding: 0.75rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 0.9rem; }
#lume-pg-{{ lm }} .lm-price-now { font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; font-weight: 400; color: var(--ink); line-height: 1; }
#lume-pg-{{ lm }} .lm-price-was { font-size: 0.8rem; color: var(--text-light); text-decoration: line-through; }
#lume-pg-{{ lm }} .lm-price-tag { margin-left: auto; background: #FFF0E6; color: #A03A10; font-size: 0.6rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.22rem 0.5rem; }
#lume-pg-{{ lm }} .lm-info-desc { font-size: 0.82rem; line-height: 1.75; color: var(--text-mid); font-weight: 300; margin-bottom: 0.6rem; }
/* DIVIDER */
#lume-pg-{{ lm }} .lm-divider { height: 8px; background: var(--cream-mid); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
/* PACKS */
#lume-pg-{{ lm }} .lm-packs-wrap { background: var(--warm-white); padding: 1.3rem 1.2rem 0.6rem; }
#lume-pg-{{ lm }} .lm-section-label { font-size: 0.58rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-light); font-weight: 400; margin-bottom: 0.9rem; }
#lume-pg-{{ lm }} .lm-packs { display: flex; flex-direction: column; gap: 0.55rem; }
#lume-pg-{{ lm }} .lm-pack { position: relative; padding: 1rem 1rem 1rem 2.75rem; border: 1px solid var(--border); cursor: pointer; background: var(--warm-white); transition: border-color 0.18s, background 0.18s; }
#lume-pg-{{ lm }} .lm-pack:hover { border-color: var(--border-warm); }
#lume-pg-{{ lm }} .lm-pack.on { border-color: var(--gold); background: var(--cream); }
#lume-pg-{{ lm }} .lm-p-badge { position: absolute; top: 0; right: 0; font-size: 0.5rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.2rem 0.55rem; }
#lume-pg-{{ lm }} .lm-p-badge.popular { background: var(--gold); color: var(--ink); }
#lume-pg-{{ lm }} .lm-p-badge.best { background: var(--ink); color: var(--gold-light); }
#lume-pg-{{ lm }} .lm-p-radio { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--cream-dark); display: flex; align-items: center; justify-content: center; transition: border-color 0.18s; flex-shrink: 0; }
#lume-pg-{{ lm }} .lm-pack.on .lm-p-radio { border-color: var(--gold); }
#lume-pg-{{ lm }} .lm-p-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); opacity: 0; transition: opacity 0.18s; }
#lume-pg-{{ lm }} .lm-pack.on .lm-p-dot { opacity: 1; }
#lume-pg-{{ lm }} .lm-p-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.2rem; }
#lume-pg-{{ lm }} .lm-p-name { font-size: 0.85rem; font-weight: 500; color: var(--ink); }
#lume-pg-{{ lm }} .lm-p-prices { text-align: right; }
#lume-pg-{{ lm }} .lm-p-price { font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 400; color: var(--ink); line-height: 1; }
#lume-pg-{{ lm }} .lm-p-unit { font-size: 0.6rem; color: var(--text-light); margin-top: 0.1rem; }
#lume-pg-{{ lm }} .lm-p-old { font-size: 0.58rem; color: var(--text-light); text-decoration: line-through; }
#lume-pg-{{ lm }} .lm-p-desc { font-size: 0.72rem; color: var(--text-mid); font-weight: 300; margin: 0; padding: 0; }
#lume-pg-{{ lm }} .lm-p-save { display: inline-block; margin-top: 0.35rem; background: var(--green-bg); color: var(--green); font-size: 0.56rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.15rem 0.45rem; }
#lume-pg-{{ lm }} .lm-p-img { width: 56px; height: 56px; object-fit: cover; flex-shrink: 0; border-radius: 3px; margin-left: 0.9rem; }
/* ORDER BAR */
#lume-pg-{{ lm }} .lm-order-bar { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 1rem 1.2rem; background: var(--cream-mid); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
#lume-pg-{{ lm }} .lm-ob-img { width: 52px; height: 52px; object-fit: cover; border-radius: 4px; flex-shrink: 0; display: none; }
#lume-pg-{{ lm }} .lm-ob-img[src]:not([src=""]) { display: block; }
#lume-pg-{{ lm }} .lm-ob-left { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; min-width: 0; }
#lume-pg-{{ lm }} .lm-ob-title { font-size: 0.78rem; font-weight: 500; color: var(--ink); }
#lume-pg-{{ lm }} .lm-ob-sub { font-size: 0.65rem; color: var(--text-mid); font-weight: 300; }
#lume-pg-{{ lm }} .lm-ob-save { font-size: 0.62rem; color: var(--green); font-weight: 500; }
#lume-pg-{{ lm }} .lm-ob-price { font-family: 'Cormorant Garamond', serif; font-size: 1.9rem; font-weight: 400; color: var(--ink); line-height: 1; text-align: right; }
/* CTA */
#lume-pg-{{ lm }} .lm-cta-wrap { padding: 1rem 1.2rem 1.1rem; background: var(--warm-white); display: flex; flex-direction: column; gap: 0.55rem; border-bottom: 1px solid var(--border); }
#lume-pg-{{ lm }} .lm-btn-cart { width: 100%; background: var(--ink); color: var(--gold-light); border: none; padding: 0.95rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.72rem; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; transition: background 0.2s; border-radius: var(--btn-radius); }
#lume-pg-{{ lm }} .lm-btn-cart:active { background: var(--ink-soft); }
#lume-pg-{{ lm }} .lm-btn-now { width: 100%; background: var(--gold); color: var(--ink); border: none; padding: 0.95rem 1rem; font-family: 'Jost', sans-serif; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; transition: background 0.2s; border-radius: var(--btn-radius); }
#lume-pg-{{ lm }} .lm-btn-now:active { background: var(--gold-light); }
#lume-pg-{{ lm }} .lm-sticky-btn { border-radius: var(--btn-radius); }
#lume-pg-{{ lm }} .lm-cta-trust { display: flex; justify-content: center; align-items: center; gap: 1.5rem; padding-top: 0.2rem; }
#lume-pg-{{ lm }} .lm-ct-item { display: flex; align-items: center; gap: 0.3rem; font-size: 0.58rem; color: var(--text-light); letter-spacing: 0.06em; }
/* STICKY ATC */
#lume-pg-{{ lm }} .lm-sticky-atc { position: fixed; bottom: 0; left: 0; right: 0; background: var(--sticky-bg); z-index: 5000; transform: translateY(110%); transition: transform 0.3s cubic-bezier(0.4,0,0.2,1); padding: 0.8rem 1.2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; box-shadow: 0 -2px 16px rgba(0,0,0,0.18); }
#lume-pg-{{ lm }} .lm-sticky-atc.show { transform: translateY(0); }
#lume-pg-{{ lm }} .lm-sticky-info { display: flex; flex-direction: column; gap: 0.12rem; flex: 1; min-width: 0; overflow: hidden; }
#lume-pg-{{ lm }} .lm-sticky-name { font-size: 0.68rem; font-weight: 500; color: var(--sticky-fg); letter-spacing: 0.05em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0.75; }
#lume-pg-{{ lm }} .lm-sticky-price { font-size: 1.2rem; font-weight: 400; color: var(--sticky-fg); font-family: 'Cormorant Garamond', serif; line-height: 1; }
#lume-pg-{{ lm }} .lm-sticky-btn { background: var(--sticky-btn-bg); color: var(--sticky-btn-fg); border: none; padding: 0.85rem 1.4rem; font-family: 'Jost', sans-serif; font-size: 0.68rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; flex-shrink: 0; white-space: nowrap; transition: opacity 0.2s; }
#lume-pg-{{ lm }} .lm-sticky-btn:active { opacity: 0.85; }
/* FEATURES */
#lume-pg-{{ lm }} .lm-features { background: var(--warm-white); }
#lume-pg-{{ lm }} .lm-feat { display: flex; align-items: flex-start; gap: 1rem; padding: 0.95rem 1.2rem; border-bottom: 1px solid var(--border); }
#lume-pg-{{ lm }} .lm-feat-ico { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
#lume-pg-{{ lm }} .lm-feat-text strong { display: block; font-size: 0.8rem; font-weight: 500; color: var(--ink); margin-bottom: 0.15rem; }
#lume-pg-{{ lm }} .lm-feat-text span { font-size: 0.72rem; color: var(--text-mid); font-weight: 300; line-height: 1.5; }
/* TABS */
#lume-pg-{{ lm }} .lm-tabs-wrap { background: var(--warm-white); }
#lume-pg-{{ lm }} .lm-tabs { display: flex; border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; }
#lume-pg-{{ lm }} .lm-tabs::-webkit-scrollbar { display: none; }
#lume-pg-{{ lm }} .lm-tab-btn { flex: 1; padding: 0.8rem 0.5rem; font-family: 'Jost', sans-serif; font-size: 0.58rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 400; color: var(--text-light); background: none; border: none; border-bottom: 1.5px solid transparent; cursor: pointer; white-space: nowrap; transition: color 0.2s, border-color 0.2s; }
#lume-pg-{{ lm }} .lm-tab-btn.on { color: var(--ink); border-bottom-color: var(--gold); }
